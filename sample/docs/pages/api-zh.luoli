coffee:
  # NOTE (luolita 0.1.4): bridged data must be single-line valid JSON.
  web = [{ "id": "api-console", "m": "console", "s": "稳定", "c": "pill-stable", "sample": "sample/web/console.js", "notes": "控制台输出：log/info/warn/error/time/count/dir；node:console 导出自定义流的 Console 类" }, { "id": "api-timers", "m": "timers", "s": "稳定", "c": "pill-stable", "sample": "sample/web/timers.js", "notes": "定时器与任务调度：setTimeout/Interval/Immediate + queueMicrotask；setImmediate 不钳 1ms" }, { "id": "api-structuredclone", "m": "structuredClone", "s": "实验", "c": "pill-exp", "sample": "sample/web/structured-clone.js", "notes": "作用：对象深拷贝。偏离：仅纯数据——Date/Map/Set/正则/类型化数组回来都是普通对象" }, { "id": "api-url", "m": "URL", "s": "稳定", "c": "pill-stable", "sample": "sample/web/url.js", "notes": "URL 解析与构造（WHATWG）；legacy url.parse/format 在 node:url" }, { "id": "api-urlsearchparams", "m": "URLSearchParams", "s": "稳定", "c": "pill-stable", "sample": "sample/web/urlsearchparams.js", "notes": "查询串构造与读取" }, { "id": "api-urlpattern", "m": "URLPattern", "s": "稳定", "c": "pill-stable", "sample": "sample/web/urlpattern.js", "notes": "路由形匹配与命名分组" }, { "id": "api-textencoder", "m": "TextEncoder", "s": "稳定", "c": "pill-stable", "sample": "sample/web/textencoder.js", "notes": "字符串编成 UTF-8 字节" }, { "id": "api-textdecoder", "m": "TextDecoder", "s": "稳定", "c": "pill-stable", "sample": "sample/web/textdecoder.js", "notes": "字节解成字符串，fatal 严格模式" }, { "id": "api-atob", "m": "atob", "s": "稳定", "c": "pill-stable", "sample": "sample/web/atob.js", "notes": "base64 解成二进制串" }, { "id": "api-btoa", "m": "btoa", "s": "稳定", "c": "pill-stable", "sample": "sample/web/btoa.js", "notes": "二进制串编成 base64" }, { "id": "api-blob", "m": "Blob", "s": "稳定", "c": "pill-stable", "sample": "sample/web/blob.js", "notes": "二进制对象：构造/切片/读取" }, { "id": "api-file", "m": "File", "s": "稳定", "c": "pill-stable", "sample": "sample/web/file.js", "notes": "带文件名与修改时间的 Blob" }, { "id": "api-fetch", "m": "fetch", "s": "稳定", "c": "pill-stable", "sample": "sample/web/fetch.js", "notes": "网络请求：data: URL 离线可用；流式体走 Web Streams" }, { "id": "api-request", "m": "Request", "s": "稳定", "c": "pill-stable", "sample": "sample/web/request.js", "notes": "方法/地址/头与请求体；偏离：无 clone()" }, { "id": "api-response", "m": "Response", "s": "稳定", "c": "pill-stable", "sample": "sample/web/response.js", "notes": "状态码/头与 body 读取；偏离：无 Response.json 静态构造、new Response(可读流) 体不接受——用 reader 收集" }, { "id": "api-headers", "m": "Headers", "s": "稳定", "c": "pill-stable", "sample": "sample/web/headers.js", "notes": "大小写不敏感的多值表" }, { "id": "api-readablestream", "m": "ReadableStream", "s": "稳定", "c": "pill-stable", "sample": "sample/web/readablestream.js", "notes": "入列与 for-await 收集" }, { "id": "api-writablestream", "m": "WritableStream", "s": "稳定", "c": "pill-stable", "sample": "sample/web/writablestream.js", "notes": "写入与关闭，可作 pipeTo 目标" }, { "id": "api-transformstream", "m": "TransformStream", "s": "稳定", "c": "pill-stable", "sample": "sample/web/transformstream.js", "notes": "块进块出的映射" }, { "id": "api-compressionstream", "m": "CompressionStream", "s": "稳定", "c": "pill-stable", "sample": "sample/web/compression-stream.js", "notes": "流式压缩：gzip/deflate + winterjs 扩展 zstd（ruzstd，编码恒 Fastest）" }, { "id": "api-decompressionstream", "m": "DecompressionStream", "s": "稳定", "c": "pill-stable", "sample": "sample/web/decompression-stream.js", "notes": "流式解压往返：gzip/deflate/zstd 已验" }, { "id": "api-crypto-webcrypto", "m": "crypto (WebCrypto)", "s": "稳定", "c": "pill-stable", "sample": "sample/web/webcrypto.js", "notes": "密码学：随机数 / 摘要 / AES-GCM / HMAC" }, { "id": "api-event", "m": "Event", "s": "稳定", "c": "pill-stable", "sample": "sample/web/event.js", "notes": "事件类型与目标，含 CustomEvent/MessageEvent/CloseEvent" }, { "id": "api-eventtarget", "m": "EventTarget", "s": "稳定", "c": "pill-stable", "sample": "sample/web/eventtarget.js", "notes": "订阅/分发/once" }, { "id": "api-abortcontroller", "m": "AbortController", "s": "稳定", "c": "pill-stable", "sample": "sample/web/abortcontroller.js", "notes": "用 signal 中止操作" }, { "id": "api-domexception", "m": "DOMException", "s": "稳定", "c": "pill-stable", "sample": "sample/web/domexception.js", "notes": "具名 DOM 错误：AbortError（码 20）" }, { "id": "api-performance", "m": "performance", "s": "稳定", "c": "pill-stable", "sample": "sample/web/performance.js", "notes": "高精度计时：now / timeOrigin；node:perf_hooks 提供同一对象" }, { "id": "api-buffer", "m": "Buffer", "s": "稳定", "c": "pill-stable", "sample": "sample/web/buffer.js", "notes": "作用：二进制缓冲。偏离：无 isAscii/isUtf8/transcode；allocUnsafe 恒零填" }, { "id": "api-websocket-client", "m": "WebSocket (client)", "s": "实验", "c": "pill-exp", "sample": "sample/web/websocket.js", "notes": "客户端 WebSocket：构造形态离线可验；live 回声走 --serve，见 sample/serve-hello/" }, { "id": "api-process", "m": "process", "s": "稳定", "c": "pill-stable", "sample": "sample/process/global.js", "notes": "全局进程对象：参数/环境/版本/nextTick" }, { "id": "api-require", "m": "require", "s": "稳定", "c": "pill-stable", "sample": "sample/process/require.js", "notes": "CJS 模块加载：导出对象/内建模块/路径解析" }, { "id": "api-module", "m": "module", "s": "稳定", "c": "pill-stable", "sample": "sample/process/module.js", "notes": "ESM 导入与 require(esm) 互操作" }]
  core = [{ "id": "api-node-assert-strict", "m": "node:assert (+/strict)", "s": "稳定", "c": "pill-stable", "sample": "sample/assert/basics.js", "notes": "断言：ok / equal / deepEqual / throws / rejects" }, { "id": "api-node-async-hooks", "m": "node:async_hooks", "s": "稳定", "c": "pill-stable", "sample": "sample/observe/basics.js", "notes": "AsyncLocalStorage 跨定时器可用" }, { "id": "api-node-buffer", "m": "node:buffer", "s": "稳定", "c": "pill-stable", "sample": "sample/web/buffer.js", "notes": "与全局 Buffer 同一类" }, { "id": "api-node-child-process", "m": "node:child_process", "s": "稳定", "c": "pill-stable", "sample": "sample/child-process/spawn.js", "notes": "子进程：用 process.execPath 启动（跨平台）" }, { "id": "api-node-cluster", "m": "node:cluster", "s": "稳定", "c": "pill-stable", "sample": "sample/cluster/primary-worker.js", "notes": "多进程（线程实现）：fork / message / disconnect / exit" }, { "id": "api-node-console", "m": "node:console", "s": "稳定", "c": "pill-stable", "sample": "sample/web/console.js", "notes": "控制台类：Console（自定义流）" }, { "id": "api-node-crypto", "m": "node:crypto", "s": "稳定", "c": "pill-stable", "sample": "sample/crypto/hash.js", "notes": "密码学全家：哈希 / HMAC / AES-GCM+CCM / ChaCha20 / ECDSA / Ed25519 / ECDH；CCM 需 authTagLength" }, { "id": "api-node-domain", "m": "node:domain", "s": "桥接", "c": "pill-bridge", "sample": "sample/observe/basics.js", "notes": "仅同步路由；异步不路由" }, { "id": "api-node-events", "m": "node:events", "s": "稳定", "c": "pill-stable", "sample": "sample/events/emitter.js", "notes": "事件发射器：on / once / off / error / 上限" }, { "id": "api-node-fs-promises", "m": "node:fs (+/promises)", "s": "稳定", "c": "pill-stable", "sample": "sample/fs/read-write.js", "notes": "文件系统：同步 / 回调 / Promise / 流 / 监听全家" }, { "id": "api-node-module", "m": "node:module", "s": "稳定", "c": "pill-stable", "sample": "sample/module/main.mjs", "notes": "模块加载：createRequire、内建 require" }, { "id": "api-node-os", "m": "node:os", "s": "稳定", "c": "pill-stable", "sample": "sample/os/info.js", "notes": "系统信息：平台 / 架构 / CPU / 内存 / 用户 / 时长 / 网卡" }, { "id": "api-node-path-posix-win32", "m": "node:path (+/posix, +/win32)", "s": "稳定", "c": "pill-stable", "sample": "sample/path/basics.js", "notes": "路径处理：join / resolve / parse / relative / extname" }, { "id": "api-node-process", "m": "node:process", "s": "稳定", "c": "pill-stable", "sample": "sample/process/basics.js", "notes": "进程控制：参数 / 环境 / 版本 / 高精度时间 / nextTick" }, { "id": "api-node-stream-promises-consumers-web", "m": "node:stream (+/promises, /consumers, /web)", "s": "稳定", "c": "pill-stable", "sample": "sample/stream/basics.js", "notes": "数据流：四类流 / pipeline / finished / text / json" }, { "id": "api-node-string-decoder", "m": "node:string_decoder", "s": "稳定", "c": "pill-stable", "sample": "sample/codecs/basics.js", "notes": "跨包多字节解码" }, { "id": "api-node-querystring-node-punycode", "m": "node:querystring / node:punycode", "s": "稳定", "c": "pill-stable", "sample": "sample/codecs/basics.js", "notes": "查询串与域名编码：parse / stringify / escape；toASCII / toUnicode" }, { "id": "api-node-sys", "m": "node:sys", "s": "稳定", "c": "pill-stable", "sample": "sample/util/basics.js", "notes": "废弃别名，与 node:util 为同一对象" }, { "id": "api-node-test", "m": "node:test", "s": "稳定", "c": "pill-stable", "sample": "sample/test-runner/basics.js", "notes": "内置测试：describe / it，--run 与 --test 下都跑" }, { "id": "api-node-timers-promises", "m": "node:timers (+/promises)", "s": "稳定", "c": "pill-stable", "sample": "sample/url-timers/basics.js", "notes": "定时器：回调 + Promise 双形态" }, { "id": "api-node-util-types", "m": "node:util (+/types)", "s": "稳定", "c": "pill-stable", "sample": "sample/util/basics.js", "notes": "工具函数：format / inspect / promisify / isMap / isPromise" }, { "id": "api-node-v8", "m": "node:v8", "s": "桥接", "c": "pill-bridge", "sample": "sample/observe/basics.js", "notes": "仅 startupSnapshot；无堆统计" }, { "id": "api-node-vm", "m": "node:vm", "s": "稳定", "c": "pill-stable", "sample": "sample/vm/basics.js", "notes": "沙箱虚拟机：Script / 上下文 / compileFunction；宿主全局不泄漏" }, { "id": "api-node-worker-threads", "m": "node:worker_threads", "s": "稳定", "c": "pill-stable", "sample": "sample/worker-threads/main.mjs", "notes": "工作线程：postMessage / terminate" }, { "id": "api-node-zlib", "m": "node:zlib", "s": "稳定", "c": "pill-stable", "sample": "sample/zlib/basics.js", "notes": "压缩解压：gzip / deflate / brotli / crc32" }]
  netio = [{ "id": "api-node-http", "m": "node:http", "s": "稳定", "c": "pill-stable", "sample": "sample/http/server-client.js", "notes": "HTTP 服务与客户端：keep-alive 复用、流式体" }, { "id": "api-node-http2", "m": "node:http2", "s": "稳定", "c": "pill-stable", "sample": "sample/http2/h2c.js", "notes": "HTTP/2：h2c 兼容服务 + 客户端会话" }, { "id": "api-node-https", "m": "node:https", "s": "稳定", "c": "pill-stable", "sample": "sample/https/get.js", "notes": "偏离：单个请求会触发两次 request 监听——请做幂等处理" }, { "id": "api-node-tls-tls-wrap", "m": "node:tls (+_tls_wrap)", "s": "稳定", "c": "pill-stable", "sample": "sample/tls/server-client.js", "notes": "TLS 传输层：样例自签证书；_tls_wrap 报 DEP0192" }, { "id": "api-node-net", "m": "node:net", "s": "稳定", "c": "pill-stable", "sample": "sample/net/tcp.js", "notes": "TCP 网络：TCP 回声；isIP / isIPv4 / isIPv6" }, { "id": "api-node-dgram", "m": "node:dgram", "s": "稳定", "c": "pill-stable", "sample": "sample/dgram/udp.js", "notes": "UDP：udp4 回声；支持组播 / connect" }, { "id": "api-node-dns-promises", "m": "node:dns (+/promises)", "s": "稳定", "c": "pill-stable", "sample": "sample/dns/lookup.js", "notes": "域名解析：lookup(localhost) 离线可用；全 resolver 读系统 DNS" }, { "id": "api-node-quic", "m": "node:quic", "s": "实验", "c": "pill-exp", "sample": "—", "notes": "仅 listen/connect 接口；本构建回环握手超时" }, { "id": "api-node-diagnostics-channel", "m": "node:diagnostics_channel", "s": "稳定", "c": "pill-stable", "sample": "sample/observe/basics.js", "notes": "诊断通道：发布订阅" }, { "id": "api-node-inspector-promises", "m": "node:inspector (+/promises)", "s": "桥接", "c": "pill-bridge", "sample": "sample/inspector/basics.js", "notes": "open/url/close 生命周期；无实时调试连接（url() 恒为 undefined）" }, { "id": "api-node-trace-events", "m": "node:trace_events", "s": "桥接", "c": "pill-bridge", "sample": "sample/trace-events/basics.js", "notes": "性能追踪：createTracing / enable / disable / getEnabledCategories" }, { "id": "api-node-tty", "m": "node:tty", "s": "稳定", "c": "pill-stable", "sample": "sample/observe/basics.js", "notes": "终端：isatty / ReadStream / WriteStream" }, { "id": "api-node-readline", "m": "node:readline", "s": "稳定", "c": "pill-stable", "sample": "sample/readline/basics.js", "notes": "交互行读取：无需终端即可使用" }, { "id": "api-node-repl", "m": "node:repl", "s": "稳定", "c": "pill-stable", "sample": "sample/repl/basics.js", "notes": "交互式求值：无需终端即可使用；Recoverable" }, { "id": "api-node-url-legacy", "m": "node:url (legacy)", "s": "稳定", "c": "pill-stable", "sample": "sample/url-timers/basics.js", "notes": "传统 URL：parse / format / resolve / Url 类" }, { "id": "api-node-perf-hooks", "m": "node:perf_hooks", "s": "稳定", "c": "pill-stable", "sample": "sample/observe/basics.js", "notes": "性能计时：performance 对象" }, { "id": "api-node-sqlite", "m": "node:sqlite", "s": "稳定", "c": "pill-stable", "sample": "sample/sqlite/basics.js", "notes": "内建数据库（turso 存储）：DatabaseSync，内存库已验" }]
  deno = [{ "id": "api-deno", "m": "Deno", "s": "稳定", "c": "pill-stable", "sample": "sample/winterjs/namespaces.js", "notes": "冻结命名空间：文件/环境/网络/服务/Command/test，与 node: 对应模块行为一致" }]
  bun = [{ "id": "api-bun-ffi", "m": "bun:ffi", "s": "实验", "c": "pill-exp", "sample": "sample/bun-ffi/strlen.js", "notes": "原生库调用：dlopen 调 libc strlen（darwin/linux 守卫）；ptr/CString 地址模型" }, { "id": "api-bun-sqlite", "m": "bun:sqlite", "s": "稳定", "c": "pill-stable", "sample": "sample/sqlite/basics.js", "notes": "内建数据库（turso 存储）：Database，内存库已验" }, { "id": "api-bun", "m": "Bun", "s": "稳定", "c": "pill-stable", "sample": "sample/winterjs/namespaces.js", "notes": "文件/子进程/服务/休眠/shell；版本/参数/环境镜像 process" }]
  wjs = [{ "id": "api-storage-localstorage", "m": "storage / localStorage", "s": "稳定", "c": "pill-stable", "sample": "sample/storage/basics.js", "notes": "WinterCG 自有 KV（turso 单文件，--storage-path）；异步 get/set/delete/has/keys/clear/size + 同步 localStorage；经 -b/--db 查看（+WinterJS.* 别名）" }, { "id": "api-winterjs-image", "m": "WinterJS.image", "s": "稳定", "c": "pill-stable", "sample": "sample/winterjs/image.js", "notes": "图像编解码：解码出 RGBA8 / 编码回去：png/jpeg/gif/webp/tiff/tga/bmp/ico/hdr/exr/pnm/farbfeld/qoi + svg/jxl 纯解码；质量参数直通" }, { "id": "api-winterjs", "m": "WinterJS", "s": "稳定", "c": "pill-stable", "sample": "sample/winterjs/namespaces.js", "notes": "运行时命名空间：版本/参数/环境/存储 + image；Deno/Bun 交叉引用" }, { "id": "api-winterjs-fs", "m": "fs / WinterJS.fs", "s": "稳定", "c": "pill-stable", "sample": "sample/wfs/basics.js", "notes": "自有文件面，与 node:fs 分离实现；异步 readFile/readTextFile/writeFile/writeTextFile/stat/mkdir/readdir/remove/rename/copyFile/exists" }, { "id": "api-winterjs-memory", "m": "WinterJS.memory/alloc/unsafe*", "s": "稳定", "c": "pill-stable", "sample": "sample/mem/basics.js", "notes": "memory() 看 rss+分配器；alloc(n) GC 托管零填；unsafeAlloc/Write/Read/Size/Free/List 手动 id 堆，需 --allow-ffi" }, { "id": "api-winterjs-semver", "m": "WinterJS.semver", "s": "稳定", "c": "pill-stable", "sample": "sample/wstd/semver.js", "notes": "版本号校验、区间与解析" }, { "id": "api-winterjs-yaml", "m": "WinterJS.yaml", "s": "稳定", "c": "pill-stable", "sample": "sample/wstd/yaml.js", "notes": "YAML 解析与序列化" }, { "id": "api-winterjs-jsonc", "m": "WinterJS.jsonc", "s": "稳定", "c": "pill-stable", "sample": "sample/wstd/jsonc.js", "notes": "容忍注释与尾逗号的 JSON" }, { "id": "api-winterjs-ip", "m": "WinterJS.ip", "s": "稳定", "c": "pill-stable", "sample": "sample/wstd/ip.js", "notes": "CIDR 包含判断与解析" }, { "id": "api-winterjs-shlex", "m": "WinterJS.shlex", "s": "稳定", "c": "pill-stable", "sample": "sample/wstd/shlex.js", "notes": "shell 切词" }, { "id": "api-winterjs-spdx", "m": "WinterJS.spdx", "s": "稳定", "c": "pill-stable", "sample": "sample/wstd/spdx.js", "notes": "SPDX 许可证表达式校验" }, { "id": "api-winterjs-qrcode", "m": "WinterJS.qrcode", "s": "稳定", "c": "pill-stable", "sample": "sample/wstd/qrcode.js", "notes": "终端二维码渲染" }, { "id": "api-winterjs-shell", "m": "WinterJS.shell", "s": "稳定", "c": "pill-stable", "sample": "sample/wsys/shell.js", "notes": "shell 词法展开：~ 与 $VAR 过 env 门" }, { "id": "api-winterjs-hex", "m": "WinterJS.hex", "s": "稳定", "c": "pill-stable", "sample": "sample/wsys/hex.js", "notes": "hex 编解码：字符串与字节互转" }, { "id": "api-winterjs-time", "m": "WinterJS.time", "s": "稳定", "c": "pill-stable", "sample": "sample/wsys/time.js", "notes": "毫秒时钟、ISO 解析与格式化" }, { "id": "api-winterjs-retry", "m": "WinterJS.retry", "s": "稳定", "c": "pill-stable", "sample": "sample/wsys/retry.js", "notes": "重试退避与 run 循环" }, { "id": "api-winterjs-graph", "m": "WinterJS.graph", "s": "稳定", "c": "pill-stable", "sample": "sample/wsys/graph.js", "notes": "有向图：节点/边、拓扑排序" }, { "id": "api-winterjs-git", "m": "WinterJS.git", "s": "稳定", "c": "pill-stable", "sample": "sample/wsys/git.js", "notes": "只读 git：rev 解析与 log" }, { "id": "api-winterjs-oauth", "m": "WinterJS.oauth", "s": "稳定", "c": "pill-stable", "sample": "sample/wsys/oauth.js", "notes": "授权 URL 拼接与 PKCE" }, { "id": "api-winterjs-transpile", "m": "WinterJS.transpile", "s": "稳定", "c": "pill-stable", "sample": "sample/wsys/transpile.js", "notes": "TypeScript 去类型转译" }, { "id": "api-winterjs-log", "m": "WinterJS.log", "s": "稳定", "c": "pill-stable", "sample": "sample/wsys/log.js", "notes": "结构化日志：debug/info/warn/error" }, { "id": "api-winterjs-mime", "m": "WinterJS.mime", "s": "稳定", "c": "pill-stable", "sample": "sample/wsys/mime.js", "notes": "扩展名查 MIME" }, { "id": "api-winterjs-cookie", "m": "WinterJS.cookie", "s": "稳定", "c": "pill-stable", "sample": "sample/wsys/cookie.js", "notes": "Cookie 解析与序列化" }, { "id": "api-winterjs-httpdate", "m": "WinterJS.httpdate", "s": "稳定", "c": "pill-stable", "sample": "sample/wsys/httpdate.js", "notes": "HTTP 日期解析与格式化" }, { "id": "api-winterjs-assert", "m": "WinterJS.assert", "s": "稳定", "c": "pill-stable", "sample": "sample/wcover/assert.js", "notes": "结构化断言（含 AssertionError）" }, { "id": "api-winterjs-util", "m": "WinterJS.util", "s": "稳定", "c": "pill-stable", "sample": "sample/wcover/util.js", "notes": "printf 风格 format 与对象 inspect" }, { "id": "api-winterjs-punycode", "m": "WinterJS.punycode", "s": "稳定", "c": "pill-stable", "sample": "sample/wcover/punycode.js", "notes": "域名编码双向转换" }, { "id": "api-winterjs-tcp", "m": "WinterJS.tcp", "s": "稳定", "c": "pill-stable", "sample": "sample/wcover/tcp.js", "notes": "回环 TCP 回声；字节流可异步迭代" }, { "id": "api-winterjs-udp", "m": "WinterJS.udp", "s": "稳定", "c": "pill-stable", "sample": "sample/wcover/udp.js", "notes": "回环 UDP 数据报" }, { "id": "api-winterjs-dns", "m": "WinterJS.dns", "s": "稳定", "c": "pill-stable", "sample": "sample/wcover/dns.js", "notes": "域名查询（localhost 离线可解）" }, { "id": "api-winterjs-tls", "m": "WinterJS.tls", "s": "稳定", "c": "pill-stable", "sample": "sample/wcover/tls.js", "notes": "回环 TLS 客户端（自签样例证书）" }, { "id": "api-winterjs-command", "m": "WinterJS.command", "s": "稳定", "c": "pill-stable", "sample": "sample/wcover/command.js", "notes": "运行与监管子进程（输出可收集可流式，需 --allow-run）" }, { "id": "api-winterjs-terminal", "m": "WinterJS.terminal", "s": "稳定", "c": "pill-stable", "sample": "sample/wcover/terminal.js", "notes": "行编辑接口面" }, { "id": "api-winterjs-repl", "m": "WinterJS.repl", "s": "稳定", "c": "pill-stable", "sample": "sample/wcover/repl.js", "notes": "REPL 服务端面" }, { "id": "api-worker", "m": "Worker", "s": "稳定", "c": "pill-stable", "sample": "sample/wcover/worker.js", "notes": "JSON 消息的 Web Worker 线程" }, { "id": "api-winterjs-cluster", "m": "WinterJS.cluster", "s": "稳定", "c": "pill-stable", "sample": "sample/wcover/cluster.js", "notes": "主/工角色面" }, { "id": "api-winterjs-test", "m": "WinterJS.test", "s": "稳定", "c": "pill-stable", "sample": "sample/wcover/test.js", "notes": "内置测试运行器面" }, { "id": "api-winterjs-vm", "m": "WinterJS.vm", "s": "稳定", "c": "pill-stable", "sample": "sample/wcover/vm.js", "notes": "脚本求值面" }, { "id": "api-winterjs-os", "m": "WinterJS.os", "s": "稳定", "c": "pill-stable", "sample": "sample/wcover/os.js", "notes": "操作系统信息" }, { "id": "api-winterjs-path", "m": "WinterJS.path", "s": "稳定", "c": "pill-stable", "sample": "sample/wcover/path.js", "notes": "路径工具" }, { "id": "api-winterjs-db", "m": "WinterJS.db", "s": "稳定", "c": "pill-stable", "sample": "sample/wcover/db.js", "notes": "内嵌 SQL 数据库" }, { "id": "api-winterjs-inspect", "m": "WinterJS.inspect", "s": "稳定", "c": "pill-stable", "sample": "sample/wcover/inspect.js", "notes": "表达式求值" }, { "id": "api-winterjs-tty", "m": "WinterJS.tty", "s": "稳定", "c": "pill-stable", "sample": "sample/wcover/tty.js", "notes": "终端检查" }, { "id": "api-winterjs-stream", "m": "WinterJS.stream", "s": "稳定", "c": "pill-stable", "sample": "sample/wcover/stream.js", "notes": "流管道" }, { "id": "api-winterjs-serve", "m": "WinterJS.serve", "s": "稳定", "c": "pill-stable", "sample": "sample/wcover/serve.js", "notes": "动静一体 HTTP 服务" }, { "id": "api-winterjs-diagnostics", "m": "WinterJS.diagnostics", "s": "稳定", "c": "pill-stable", "sample": "sample/wcover/diagnostics.js", "notes": "诊断通道发布订阅" }, { "id": "api-winterjs-domain", "m": "WinterJS.domain", "s": "稳定", "c": "pill-stable", "sample": "sample/wcover/domain.js", "notes": "同步错误路由" }, { "id": "api-winterjs-trace", "m": "WinterJS.trace", "s": "稳定", "c": "pill-stable", "sample": "sample/wcover/trace.js", "notes": "追踪分类" }, { "id": "api-winterjs-asynclocalstorage", "m": "WinterJS.AsyncLocalStorage", "s": "稳定", "c": "pill-stable", "sample": "sample/wcover/asynclocalstorage.js", "notes": "跨定时器的上下文" }, { "id": "api-winterjs-quic", "m": "WinterJS.quic", "s": "实验", "c": "pill-exp", "sample": "sample/wcover/quic.js", "notes": "仅接口面；本构建回环握手不支持" }, { "id": "api-winterjs-crypto", "m": "WinterJS.crypto", "s": "稳定", "c": "pill-stable", "sample": "sample/wcover/crypto.js", "notes": "WebCrypto 别名面" }, { "id": "api-winterjs-ffi", "m": "WinterJS.ffi", "s": "实验", "c": "pill-exp", "sample": "sample/wcover/ffi.js", "notes": "bun:ffi 别名面；偏离：WinterJS.ffi 本构建恒 null，直引 bun:ffi（需 --allow-ffi）" }, { "id": "api-winterjs-media", "m": "WinterJS.media", "s": "稳定", "c": "pill-stable", "sample": "sample/media/basics.js", "notes": "音频解码/放音（symphonia/rodio）+ AV1 编码（rav1e，IVF）+ MP4 解复用（mp4-rs）；PCM f32，质量参数直通" }]

template:
  h1 winterjs API 参考
  blockquote 体例对标 #[a(href='https://nodejs.org/docs/latest/api/') nodejs.org/api]：每模块一节，标注稳定性，给出导入形态、链接样例，并列出#[strong 已知偏离]（2026-09-27 经 #[code winterjs --run sample/...] 逐项实测）。English version: #[a(href='#/en/api') API reference].
  p 稳定性：#[span.pill.pill-stable 稳定] 跟随 Node 语义；#[span.pill.pill-exp 实验] 可用但在演进；#[span.pill.pill-bridge 桥接] 有意裁剪的面。
  p 可运行索引：每行对应 #[code sample/&lt;领域&gt;/] 下的样例。
  h2 WinterJS 原生
  table
    thead
      tr
        th API
        th 稳定性
        th 样例
        th 说明
    tbody
      each n in wjs
        tr(id=n.id)
          td: code= n.m
          td: span.pill(class=n.c)= n.s
          td
            if n.sample == '—'
              | —
            else
              button.sample-link(type='button' data-sample=n.sample title='预览源码')= n.sample
          td!= n.notes
  h2 Web 全局（免导入）
  table
    thead
      tr
        th 全局
        th 稳定性
        th 样例
        th 说明
    tbody
      each g in web
        tr(id=g.id)
          td: code= g.m
          td: span.pill(class=g.c)= g.s
          td
            if g.sample == '—'
              | —
            else
              button.sample-link(type='button' data-sample=g.sample title='预览源码')= g.sample
          td!= g.notes
  h2 node: 模块——核心
  table
    thead
      tr
        th 模块
        th 稳定性
        th 样例
        th 说明
    tbody
      each m in core
        tr(id=m.id)
          td: code= m.m
          td: span.pill(class=m.c)= m.s
          td
            if m.sample == '—'
              | —
            else
              button.sample-link(type='button' data-sample=m.sample title='预览源码')= m.sample
          td!= m.notes
  h2 node: 模块——网络与 I/O
  table
    thead
      tr
        th 模块
        th 稳定性
        th 样例
        th 说明
    tbody
      each m in netio
        tr(id=m.id)
          td: code= m.m
          td: span.pill(class=m.c)= m.s
          td
            if m.sample == '—'
              | —
            else
              button.sample-link(type='button' data-sample=m.sample title='预览源码')= m.sample
          td!= m.notes
  h2 Bun 兼容
  table
    thead
      tr
        th API
        th 稳定性
        th 样例
        th 说明
    tbody
      each b in bun
        tr(id=b.id)
          td: code= b.m
          td: span.pill(class=b.c)= b.s
          td
            if b.sample == '—'
              | —
            else
              button.sample-link(type='button' data-sample=b.sample title='预览源码')= b.sample
          td!= b.notes
  h2 Deno 兼容
  table
    thead
      tr
        th API
        th 稳定性
        th 样例
        th 说明
    tbody
      each d in deno
        tr(id=d.id)
          td: code= d.m
          td: span.pill(class=d.c)= d.s
          td
            if d.sample == '—'
              | —
            else
              button.sample-link(type='button' data-sample=d.sample title='预览源码')= d.sample
          td!= d.notes
  h2 不做（设计如此）
  ul
    li #[code wasi]、#[code sea] —— 无对等计划。
    li N-API 原生 addon（#[code .node]）可经 napi 面加载，但针对 winterjs 头写 C addon 不在样例范围。
  h2 错误与警告
  ul
    li 未捕获错误按 node 形渲染（#[code 文件:行]、源码行、#[code ^]、#[code 名: 消息]、#[code at] 栈），exit=1；#[code throw &lt;非 Error&gt;] 打印值本身。
    li #[code process.emitWarning] 异步派发（nextTick），与 Node 一致。
