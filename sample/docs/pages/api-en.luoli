coffee:
  # NOTE (luolita 0.1.4): bridged data must be single-line valid JSON.
  web = [{ "id": "api-console", "m": "console", "s": "Stable", "c": "pill-stable", "sample": "sample/web/console.js", "notes": "log/info/warn/error/time/count/dir; node:console exports the Console class" }, { "id": "api-timers", "m": "timers", "s": "Stable", "c": "pill-stable", "sample": "sample/web/timers.js", "notes": "setTimeout/Interval/Immediate + queueMicrotask; setImmediate is not clamped to 1ms" }, { "id": "api-structuredclone", "m": "structuredClone", "s": "Experimental", "c": "pill-exp", "sample": "sample/web/structured-clone.js", "notes": "Deviation: plain data only — Date/Map/Set/RegExp/TypedArray come back as plain objects" }, { "id": "api-url-urlsearchparams-urlpattern", "m": "URL / URLSearchParams / URLPattern", "s": "Stable", "c": "pill-stable", "sample": "sample/web/url.js", "notes": "WHATWG; legacy url.parse/format lives in node:url" }, { "id": "api-textencoder-textdecoder-atob-btoa", "m": "TextEncoder / TextDecoder / atob / btoa", "s": "Stable", "c": "pill-stable", "sample": "sample/web/url.js", "notes": "fatal:true supported" }, { "id": "api-blob-file", "m": "Blob / File", "s": "Stable", "c": "pill-stable", "sample": "sample/web/blob-file.js", "notes": "slice / text / arrayBuffer" }, { "id": "api-fetch-request-response-headers", "m": "fetch / Request / Response / Headers", "s": "Stable", "c": "pill-stable", "sample": "sample/web/fetch.js", "notes": "data: URLs work offline; streaming bodies via Web Streams" }, { "id": "api-readablestream-writablestream-transformstream", "m": "ReadableStream / WritableStream / TransformStream", "s": "Stable", "c": "pill-stable", "sample": "sample/web/streams.js", "notes": "for-await consumption. Deviation: new Response(stream) body not accepted — collect via reader" }, { "id": "api-compressionstream-decompressionstream", "m": "CompressionStream / DecompressionStream", "s": "Stable", "c": "pill-stable", "sample": "sample/web/compression.js", "notes": "gzip + deflate + winterjs-extension zstd (ruzstd; encodes at Fastest) verified round-trips" }, { "id": "api-crypto-webcrypto", "m": "crypto (WebCrypto)", "s": "Stable", "c": "pill-stable", "sample": "sample/web/webcrypto.js", "notes": "getRandomValues / randomUUID / subtle digest, AES-GCM, HMAC" }, { "id": "api-event-eventtarget-abortcontroller", "m": "Event / EventTarget / AbortController", "s": "Stable", "c": "pill-stable", "sample": "sample/web/events.js", "notes": "CustomEvent / MessageEvent / CloseEvent included" }, { "id": "api-domexception", "m": "DOMException", "s": "Stable", "c": "pill-stable", "sample": "sample/web/events.js", "notes": "named errors (AbortError code 20)" }, { "id": "api-performance", "m": "performance", "s": "Stable", "c": "pill-stable", "sample": "sample/web/performance.js", "notes": "now / timeOrigin; node:perf_hooks re-exports + extras" }, { "id": "api-buffer", "m": "Buffer", "s": "Stable", "c": "pill-stable", "sample": "sample/web/buffer.js", "notes": "Deviation: isAscii/isUtf8/transcode absent; allocUnsafe is zero-filled" }, { "id": "api-websocket-client", "m": "WebSocket (client)", "s": "Experimental", "c": "pill-exp", "sample": "sample/web/websocket.js", "notes": "constructor shape offline; live echo via --serve, see sample/serve-hello/" }, { "id": "api-process-require-module", "m": "process / require / module", "s": "Stable", "c": "pill-stable", "sample": "sample/process/basics.js", "notes": "CJS + ESM interop; require(esm) supported" }]
  core = [{ "id": "api-node-assert-strict", "m": "node:assert (+/strict)", "s": "Stable", "c": "pill-stable", "sample": "sample/assert/basics.js", "notes": "ok / equal / deepEqual / throws / rejects" }, { "id": "api-node-async-hooks", "m": "node:async_hooks", "s": "Stable", "c": "pill-stable", "sample": "sample/observe/basics.js", "notes": "AsyncLocalStorage run/getStore across timers" }, { "id": "api-node-buffer", "m": "node:buffer", "s": "Stable", "c": "pill-stable", "sample": "sample/web/buffer.js", "notes": "same class as global Buffer" }, { "id": "api-node-child-process", "m": "node:child_process", "s": "Stable", "c": "pill-stable", "sample": "sample/child-process/spawn.js", "notes": "spawnSync/execFileSync via process.execPath (cross-platform)" }, { "id": "api-node-cluster", "m": "node:cluster", "s": "Stable", "c": "pill-stable", "sample": "sample/cluster/primary-worker.js", "notes": "thread-based; fork / message / disconnect / exit" }, { "id": "api-node-console", "m": "node:console", "s": "Stable", "c": "pill-stable", "sample": "sample/web/console.js", "notes": "Console class over custom streams" }, { "id": "api-node-crypto", "m": "node:crypto", "s": "Stable", "c": "pill-stable", "sample": "sample/crypto/hash.js", "notes": "hash / HMAC / AES-GCM+CCM / ChaCha20 / ECDSA / Ed25519 / ECDH; CCM needs authTagLength" }, { "id": "api-node-domain", "m": "node:domain", "s": "Bridge", "c": "pill-bridge", "sample": "sample/observe/basics.js", "notes": "sync routing only; async not routed" }, { "id": "api-node-events", "m": "node:events", "s": "Stable", "c": "pill-stable", "sample": "sample/events/emitter.js", "notes": "on / once / off / error / maxListeners" }, { "id": "api-node-fs-promises", "m": "node:fs (+/promises)", "s": "Stable", "c": "pill-stable", "sample": "sample/fs/read-write.js", "notes": "sync / callback / promise / stream / watch faces" }, { "id": "api-node-module", "m": "node:module", "s": "Stable", "c": "pill-stable", "sample": "sample/module/main.mjs", "notes": "createRequire, builtin require" }, { "id": "api-node-os", "m": "node:os", "s": "Stable", "c": "pill-stable", "sample": "sample/os/info.js", "notes": "platform / arch / cpus / mem / user / uptime / net" }, { "id": "api-node-path-posix-win32", "m": "node:path (+/posix, +/win32)", "s": "Stable", "c": "pill-stable", "sample": "sample/path/basics.js", "notes": "join / resolve / parse / relative / extname" }, { "id": "api-node-process", "m": "node:process", "s": "Stable", "c": "pill-stable", "sample": "sample/process/basics.js", "notes": "argv / env / cwd / versions / hrtime / nextTick" }, { "id": "api-node-stream-promises-consumers-web", "m": "node:stream (+/promises, /consumers, /web)", "s": "Stable", "c": "pill-stable", "sample": "sample/stream/basics.js", "notes": "Readable / Writable / Transform / pipeline / finished / text / json" }, { "id": "api-node-string-decoder", "m": "node:string_decoder", "s": "Stable", "c": "pill-stable", "sample": "sample/codecs/basics.js", "notes": "split multibyte decode" }, { "id": "api-node-querystring-node-punycode", "m": "node:querystring / node:punycode", "s": "Stable", "c": "pill-stable", "sample": "sample/codecs/basics.js", "notes": "parse / stringify / escape; toASCII / toUnicode" }, { "id": "api-node-sys", "m": "node:sys", "s": "Stable", "c": "pill-stable", "sample": "sample/util/basics.js", "notes": "deprecated alias, same instance as node:util" }, { "id": "api-node-test", "m": "node:test", "s": "Stable", "c": "pill-stable", "sample": "sample/test-runner/basics.js", "notes": "describe / it; runs under --run and --test" }, { "id": "api-node-timers-promises", "m": "node:timers (+/promises)", "s": "Stable", "c": "pill-stable", "sample": "sample/url-timers/basics.js", "notes": "callback + promise faces" }, { "id": "api-node-util-types", "m": "node:util (+/types)", "s": "Stable", "c": "pill-stable", "sample": "sample/util/basics.js", "notes": "format / inspect / promisify / isMap / isPromise" }, { "id": "api-node-v8", "m": "node:v8", "s": "Bridge", "c": "pill-bridge", "sample": "sample/observe/basics.js", "notes": "only startupSnapshot; heap/serializer intentionally absent" }, { "id": "api-node-vm", "m": "node:vm", "s": "Stable", "c": "pill-stable", "sample": "sample/vm/basics.js", "notes": "Script / context / compileFunction; host globals not leaked" }, { "id": "api-node-worker-threads", "m": "node:worker_threads", "s": "Stable", "c": "pill-stable", "sample": "sample/worker-threads/main.mjs", "notes": "postMessage / terminate" }, { "id": "api-node-zlib", "m": "node:zlib", "s": "Stable", "c": "pill-stable", "sample": "sample/zlib/basics.js", "notes": "gzip / deflate / brotli / crc32" }]
  netio = [{ "id": "api-node-http", "m": "node:http", "s": "Stable", "c": "pill-stable", "sample": "sample/http/server-client.js", "notes": "keep-alive agent, streaming bodies" }, { "id": "api-node-http2", "m": "node:http2", "s": "Stable", "c": "pill-stable", "sample": "sample/http2/h2c.js", "notes": "h2c compat server + client session" }, { "id": "api-node-https", "m": "node:https", "s": "Stable", "c": "pill-stable", "sample": "sample/https/get.js", "notes": "Deviation: request listener currently fires twice per request — guard idempotently" }, { "id": "api-node-tls-tls-wrap", "m": "node:tls (+_tls_wrap)", "s": "Stable", "c": "pill-stable", "sample": "sample/tls/server-client.js", "notes": "fixture cert; _tls_wrap emits DEP0192" }, { "id": "api-node-net", "m": "node:net", "s": "Stable", "c": "pill-stable", "sample": "sample/net/tcp.js", "notes": "TCP echo; isIP / isIPv4 / isIPv6" }, { "id": "api-node-dgram", "m": "node:dgram", "s": "Stable", "c": "pill-stable", "sample": "sample/dgram/udp.js", "notes": "udp4 echo; multicast / connect supported" }, { "id": "api-node-dns-promises", "m": "node:dns (+/promises)", "s": "Stable", "c": "pill-stable", "sample": "sample/dns/lookup.js", "notes": "lookup(localhost) offline; full resolver via system DNS" }, { "id": "api-node-quic", "m": "node:quic", "s": "Experimental", "c": "pill-exp", "sample": "—", "notes": "listen/connect surface only; loopback handshake times out in this build" }, { "id": "api-node-diagnostics-channel", "m": "node:diagnostics_channel", "s": "Stable", "c": "pill-stable", "sample": "sample/observe/basics.js", "notes": "channel publish / subscribe" }, { "id": "api-node-inspector-promises", "m": "node:inspector (+/promises)", "s": "Bridge", "c": "pill-bridge", "sample": "sample/inspector/basics.js", "notes": "open/url/close lifecycle; no live wire (url() stays undefined)" }, { "id": "api-node-trace-events", "m": "node:trace_events", "s": "Bridge", "c": "pill-bridge", "sample": "sample/trace-events/basics.js", "notes": "createTracing / enable / disable / getEnabledCategories" }, { "id": "api-node-tty", "m": "node:tty", "s": "Stable", "c": "pill-stable", "sample": "sample/observe/basics.js", "notes": "isatty / ReadStream / WriteStream" }, { "id": "api-node-readline", "m": "node:readline", "s": "Stable", "c": "pill-stable", "sample": "sample/readline/basics.js", "notes": "stream-backed, no TTY needed" }, { "id": "api-node-repl", "m": "node:repl", "s": "Stable", "c": "pill-stable", "sample": "sample/repl/basics.js", "notes": "start over memory streams (no TTY); Recoverable" }, { "id": "api-node-url-legacy", "m": "node:url (legacy)", "s": "Stable", "c": "pill-stable", "sample": "sample/url-timers/basics.js", "notes": "parse / format / resolve / Url class" }, { "id": "api-node-perf-hooks", "m": "node:perf_hooks", "s": "Stable", "c": "pill-stable", "sample": "sample/observe/basics.js", "notes": "performance object" }, { "id": "api-node-sqlite", "m": "node:sqlite", "s": "Stable", "c": "pill-stable", "sample": "sample/sqlite/basics.js", "notes": "DatabaseSync, in-memory verified (turso base)" }]
  deno = [{ "id": "api-deno", "m": "Deno", "s": "Stable", "c": "pill-stable", "sample": "sample/winterjs/namespaces.js", "notes": "frozen namespace: fs/env/net/serve/Command/test over the node: base" }]
  bun = [{ "id": "api-bun-ffi", "m": "bun:ffi", "s": "Experimental", "c": "pill-exp", "sample": "sample/bun-ffi/strlen.js", "notes": "dlopen libc strlen (darwin/linux guarded); ptr/CString address model" }, { "id": "api-bun-sqlite", "m": "bun:sqlite", "s": "Stable", "c": "pill-stable", "sample": "sample/sqlite/basics.js", "notes": "Database, in-memory verified (turso base)" }, { "id": "api-bun", "m": "Bun", "s": "Stable", "c": "pill-stable", "sample": "sample/winterjs/namespaces.js", "notes": "file/write/spawn/serve/sleep/shell; version/argv/env mirror process" }]
  wjs = [{ "id": "api-storage-localstorage", "m": "storage / localStorage", "s": "Stable", "c": "pill-stable", "sample": "sample/storage/basics.js", "notes": "WinterCG own KV (turso single file, --storage-path); async get/set/delete/has/keys/clear/size + sync Web Storage shim; inspect via -b/--db (+WinterJS.* alias)" }, { "id": "api-winterjs-image", "m": "WinterJS.image", "s": "Stable", "c": "pill-stable", "sample": "sample/winterjs/image.js", "notes": "decode to RGBA8 / encode back: png/jpeg/gif/webp/tiff/tga/bmp/ico/hdr/exr/pnm/farbfeld/qoi + svg/jxl decode-only; quality params pass through" }, { "id": "api-winterjs", "m": "WinterJS", "s": "Stable", "c": "pill-stable", "sample": "sample/winterjs/namespaces.js", "notes": "runtime namespace: version/args/env/storage + image; Deno/Bun cross-refs" }, { "id": "api-winterjs-fs", "m": "fs / WinterJS.fs", "s": "Stable", "c": "pill-stable", "sample": "sample/wfs/basics.js", "notes": "Own file surface, separate from node:fs (direct fs-err); async readFile/readTextFile/writeFile/writeTextFile/stat/mkdir/readdir/remove/rename/copyFile/exists" }, { "id": "api-winterjs-memory", "m": "WinterJS.memory/alloc/unsafe*", "s": "Stable", "c": "pill-stable", "sample": "sample/mem/basics.js", "notes": "memory() rss+allocator; alloc(n) GC-managed zero-filled Uint8Array; unsafeAlloc/Write/Read/Size/Free/List manual id heap behind --allow-ffi" }, { "id": "api-winterjs-utils", "m": "WinterJS.semver/yaml/jsonc/ip/shlex/spdx/qrcode", "s": "Stable", "c": "pill-stable", "sample": "sample/wstd/basics.js", "notes": "Version ranges, YAML, comment-tolerant JSON, IP/CIDR checks, shell lexing, SPDX expressions and terminal QR codes" }, { "id": "api-winterjs-sys", "m": "WinterJS.shell/hex/time/retry/graph/git/oauth/transpile/log/mime/cookie/httpdate", "s": "Stable", "c": "pill-stable", "sample": "sample/wsys/basics.js", "notes": "Shell expansion, hex codec, clock, retry helpers, graphs, read-only git, OAuth helpers, TypeScript transpile, structured log, MIME/cookie/date codecs" }, { "id": "api-winterjs-cover", "m": "WinterJS.assert/util/punycode", "s": "Stable", "c": "pill-stable", "sample": "sample/wcover/b1.js", "notes": "Structural assertions with AssertionError; printf-style format and object inspect; punycode conversion" }, { "id": "api-winterjs-net", "m": "WinterJS.tcp/udp/dns/tls", "s": "Stable", "c": "pill-stable", "sample": "sample/wcover/b2.js", "notes": "Promise-based TCP/UDP sockets, DNS lookup and TLS clients; byte streams are async-iterable" }, { "id": "api-winterjs-proc", "m": "WinterJS.command/terminal/repl", "s": "Stable", "c": "pill-stable", "sample": "sample/wcover/b3.js", "notes": "Run and supervise child processes with captured or streamed output; line-editing and REPL server faces" }, { "id": "api-winterjs-conc", "m": "Worker + WinterJS.cluster/test/vm", "s": "Stable", "c": "pill-stable", "sample": "sample/wcover/b4.js", "notes": "Web Worker threads with JSON messaging; cluster, test-runner and script-evaluation faces" }, { "id": "api-winterjs-os", "m": "WinterJS.os/path/db/inspect/tty", "s": "Stable", "c": "pill-stable", "sample": "sample/wcover/b5.js", "notes": "OS facts, path utilities, embedded SQL database, expression evaluator and TTY check" }, { "id": "api-winterjs-ev", "m": "WinterJS.stream/serve/diagnostics/domain/trace/AsyncLocalStorage/quic/crypto/ffi", "s": "Stable", "c": "pill-stable", "sample": "sample/wcover/b6.js", "notes": "Stream pipelining, static-plus-dynamic HTTP serving, diagnostics, sandboxing helpers and misc system faces" }]

template:
  h1 winterjs API Reference
  blockquote Style follows #[a(href='https://nodejs.org/docs/latest/api/') nodejs.org/api]: one section per module, stability marker, import form, sample link, and #[strong known deviations] (verified against #[code winterjs --run sample/...], 2026-09-27). 中文版见 #[a(href='#/zh/api') API 参考].
  p Stability: #[span.pill.pill-stable Stable] tracks Node semantics; #[span.pill.pill-exp Experimental] present but evolving; #[span.pill.pill-bridge Bridge] intentionally reduced surface.
  p Quick runnable index: every row has a sample under #[code sample/&lt;area&gt;/].
  h2 WinterJS native · WinterJS 原生
  table
    thead
      tr
        th API
        th Stability
        th Sample
        th Notes
    tbody
      each n in wjs
        tr(id=n.id)
          td: code= n.m
          td: span.pill(class=n.c)= n.s
          td
            if n.sample == '—'
              | —
            else
              button.sample-link(type='button' data-sample=n.sample title='preview source')= n.sample
          td!= n.notes
  h2 Web globals (no import)
  table
    thead
      tr
        th Global
        th Stability
        th Sample
        th Notes
    tbody
      each g in web
        tr(id=g.id)
          td: code= g.m
          td: span.pill(class=g.c)= g.s
          td
            if g.sample == '—'
              | —
            else
              button.sample-link(type='button' data-sample=g.sample title='preview source')= g.sample
          td!= g.notes
  h2 node: modules — core
  table
    thead
      tr
        th Module
        th Stability
        th Sample
        th Notes
    tbody
      each m in core
        tr(id=m.id)
          td: code= m.m
          td: span.pill(class=m.c)= m.s
          td
            if m.sample == '—'
              | —
            else
              button.sample-link(type='button' data-sample=m.sample title='preview source')= m.sample
          td!= m.notes
  h2 node: modules — network &amp; I/O
  table
    thead
      tr
        th Module
        th Stability
        th Sample
        th Notes
    tbody
      each m in netio
        tr(id=m.id)
          td: code= m.m
          td: span.pill(class=m.c)= m.s
          td
            if m.sample == '—'
              | —
            else
              button.sample-link(type='button' data-sample=m.sample title='preview source')= m.sample
          td!= m.notes
  h2 Bun compatibility · Bun 兼容
  table
    thead
      tr
        th API
        th Stability
        th Sample
        th Notes
    tbody
      each b in bun
        tr(id=b.id)
          td: code= b.m
          td: span.pill(class=b.c)= b.s
          td
            if b.sample == '—'
              | —
            else
              button.sample-link(type='button' data-sample=b.sample title='preview source')= b.sample
          td!= b.notes
  h2 Deno compatibility · Deno 兼容
  table
    thead
      tr
        th API
        th Stability
        th Sample
        th Notes
    tbody
      each d in deno
        tr(id=d.id)
          td: code= d.m
          td: span.pill(class=d.c)= d.s
          td
            if d.sample == '—'
              | —
            else
              button.sample-link(type='button' data-sample=d.sample title='preview source')= d.sample
          td!= d.notes
  h2 Not supported (by design)
  ul
    li #[code wasi], #[code sea] — no equivalent planned.
    li N-API native addons (#[code .node]) load via the napi surface, but writing C addons against winterjs headers is out of scope for these samples.
  h2 Errors &amp; warnings
  ul
    li Uncaught errors render Node-style (#[code file:line], source line, #[code ^], #[code Name: message], #[code at] stack) with exit 1; #[code throw &lt;non-Error&gt;] prints the value.
    li #[code process.emitWarning] dispatches asynchronously (nextTick), matching Node.
