coffee:
  # NOTE (luolita 0.1.4): bridged data must be single-line valid JSON.
  actions = [{ "f": "-r / --run &lt;文件|脚本名&gt;", "e": "跑 JS 文件或 package.json 脚本；打印完成值。.bin 里的 JS bin 经自身递归执行（零 node）。--watch 变更重跑" }, { "f": "-e / --eval &lt;代码&gt;", "e": "求值内联 JS，打印完成值" }, { "f": "-c / --config [--schema]", "e": "打印解析后的配置，或其 JSON Schema" }, { "f": "-C / --completions &lt;SHELL&gt;", "e": "打印 shell 补全脚本（bash/elvish/fish/powershell/zsh）" }, { "f": "-m / --man", "e": "打印 roff 手册页到标准输出" }, { "f": "-a / --add &lt;包...&gt;", "e": "给本地 node_modules 加包" }, { "f": "-i / --install &lt;包...&gt;", "e": "全局安装包（共享数据目录）" }, { "f": "-R / --remove &lt;包...&gt;", "e": "从本地 node_modules 删包（连带 .bin 链接 + lockfile）" }, { "f": "-U / --uninstall &lt;包...&gt;", "e": "卸载全局安装的包" }, { "f": "-p / --publish [--dry-run]", "e": "发布当前包（--dry-run 只校验）" }, { "f": "--login", "e": "登录 registry（令牌进 ~/.npmrc）" }, { "f": "-u / --upgrade [--dry-run]", "e": "自升级（需 WINTERJS_UPDATE_GITHUB=owner/repo）" }, { "f": "-I / --init [名]", "e": "建包脚手架；已有 package.json 依赖则安装" }, { "f": "--repl", "e": "交互式 REPL" }, { "f": "-t / --test [路径...]", "e": "跑测试文件；无路径则从 cwd 自动发现。--watch 重跑" }, { "f": "-L / --lint [参数...]", "e": "转发给 oxlint（.bin 或 PATH），参数原样" }, { "f": "-f / --fmt [参数...]", "e": "转发给 oxfmt，参数原样" }, { "f": "-s / --serve [目录]", "e": "以 H1/H2/H3 提供目录/JS handler（export default { fetch }）；TLS 走 --cert/--key 或 ACME。--watch 变更重启" }, { "f": "-b / --db &lt;文件&gt; [--exec &lt;SQL&gt;]", "e": "查看 turso/SQLite 数据库文件（默认列出全部表）。存储库经 --storage-path 指定" }] }]
  scope = [{ "m": "-d / --dry-run", "w": "--add / --install / --remove / --uninstall / --publish / --init / --upgrade / --serve / --db" }, { "m": "--registry", "w": "--add / --install / --publish / --login / --init" }, { "m": "-T / --tag", "w": "--publish" }, { "m": "--token、-o / --oauth", "w": "--login" }, { "m": "-n / --name、-y/--yes、--force", "w": "--init" }, { "m": "-F / --filter、--test-name-pattern", "w": "--test" }, { "m": "-w / --watch", "w": "--test / --run / --serve" }, { "m": "-D / --dir / -H / --host / -P / --port / --handler / --limit-rps / --cert / -k / --key / --acme-domain / -E / --acme-email / --acme-cache / --acme-production", "w": "--serve" }, { "m": "-S / --schema", "w": "--config" }, { "m": "--exec", "w": "--db" }, { "m": "--storage-path", "w": "--run / --eval / --test / --repl / --serve" }, { "m": "--allow-read / -W / --allow-write / --allow-env / --allow-run / --allow-ffi / -A / --allow-all", "w": "--run / --eval / --test / --repl / --db" }, { "m": "-v/--verbose、-l/--lang", "w": "全局" }, { "m": "-hide_banner", "w": "全局（隐藏启动 banner，致敬 ffmpeg 同名选项）" }, { "m": "-ascii_banner", "w": "全局（强制 ASCII banner）" }]

template:
  h1 winterjs CLI 参考
  blockquote 真相以二进制为准：#[code winterjs --help]（中文用 #[code -l zh --help]）。本页讲 flag 背后的#[strong 规则]。English version: #[a(href='#/en/cli') CLI reference].
  h2 规则
  ol
    li #[strong 一次恰好一个动作]。#[code --run a.js --eval 1] → exit=1。
    li #[strong 无裸子命令、无裸位置参数]。#[code winterjs a.js] 是错的，用 #[code winterjs --run a.js]。唯一的尾部位置参数是 #[code --run] 的#[em 脚本参数]（#[code process.argv.slice(2)]），建议用 #[code --] 分隔：#[code winterjs --run app.js -- --port 8080]。无任何参数的裸 #[code winterjs] 直接进交互式 REPL（node/python 同款）。
    li #[strong 修饰 flag 只在对应动作下生效]。配错直接 exit=1：#[code --X only works with --Y (see --help)]。
  h2 动作
  table
    thead
      tr
        th Flag
        th 效果
    tbody
      each a in actions
        tr
          td!= a.f
          td!= a.e
  h2 修饰归属
  table
    thead
      tr
        th 修饰
        th 只配
    tbody
      each s in scope
        tr
          td!= s.m
          td!= s.w
  p 沙箱模型：不给任何 #[code --allow-*] → 全开放（历史行为）；给了任一 → 开沙箱，未授权类别拒绝并报 #[code PermissionError]。
  h2 退出码
  p #[code 0] 正常 · #[code 1] 运行/用法错（未捕获 JS、flag 配错） · #[code 2] clap 解析错（如 #[code -l] 非法值） · #[code 9] 非法 node 兼容旗值或自递归守卫 · 脚本 #[code process.exit(n)] 透传 #[code n]。
  h2 Node 兼容旗
  p node 运行时旗（#[code --expose-internals]、#[code --experimental-*] 等）解析前剥除，记在 #[code process.execArgv]，经 #[code internal/options] 读回。剥过旗时接受 #[code node --flag file args] 形（自动补 #[code --run]）；无兼容旗的裸 #[code winterjs file.js] 照旧报错。非法旗#[em 值] exit=9（绝不剥掉重跑同一文件）。
