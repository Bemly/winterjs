coffee:
  # NOTE (luolita 0.1.4): bridged data must be single-line valid JSON.
  web = [{ "id": "api-console", "m": "console", "s": "Stable", "c": "pill-stable", "sample": "sample/web/console.js", "notes": "log/info/warn/error/time/count/dir; node:console exports the Console class" }, { "id": "api-timers", "m": "timers", "s": "Stable", "c": "pill-stable", "sample": "sample/web/timers.js", "notes": "setTimeout/Interval/Immediate + queueMicrotask; setImmediate is not clamped to 1ms" }, { "id": "api-structuredclone", "m": "structuredClone", "s": "Experimental", "c": "pill-exp", "sample": "sample/web/structured-clone.js", "notes": "Deviation: plain data only — Date/Map/Set/RegExp/TypedArray come back as plain objects" }, { "id": "api-url", "m": "URL", "s": "Stable", "c": "pill-stable", "sample": "sample/web/url.js", "notes": "WHATWG; legacy url.parse/format lives in node:url" }, { "id": "api-urlsearchparams", "m": "URLSearchParams", "s": "Stable", "c": "pill-stable", "sample": "sample/web/urlsearchparams.js", "notes": "Query string building and reading" }, { "id": "api-urlpattern", "m": "URLPattern", "s": "Stable", "c": "pill-stable", "sample": "sample/web/urlpattern.js", "notes": "Route-style matching with named groups" }, { "id": "api-textencoder", "m": "TextEncoder", "s": "Stable", "c": "pill-stable", "sample": "sample/web/textencoder.js", "notes": "Strings to UTF-8 bytes" }, { "id": "api-textdecoder", "m": "TextDecoder", "s": "Stable", "c": "pill-stable", "sample": "sample/web/textdecoder.js", "notes": "Bytes to strings, with fatal:true mode" }, { "id": "api-atob", "m": "atob", "s": "Stable", "c": "pill-stable", "sample": "sample/web/atob.js", "notes": "Base64 to binary string" }, { "id": "api-btoa", "m": "btoa", "s": "Stable", "c": "pill-stable", "sample": "sample/web/btoa.js", "notes": "Binary string to base64" }, { "id": "api-blob", "m": "Blob", "s": "Stable", "c": "pill-stable", "sample": "sample/web/blob.js", "notes": "construct / slice / read" }, { "id": "api-file", "m": "File", "s": "Stable", "c": "pill-stable", "sample": "sample/web/file.js", "notes": "Named Blob with lastModified" }, { "id": "api-fetch", "m": "fetch", "s": "Stable", "c": "pill-stable", "sample": "sample/web/fetch.js", "notes": "data: URLs work offline; streaming bodies via Web Streams" }, { "id": "api-request", "m": "Request", "s": "Stable", "c": "pill-stable", "sample": "sample/web/request.js", "notes": "Method/URL/headers/body; clone() copies everything (signal follows)" }, { "id": "api-response", "m": "Response", "s": "Stable", "c": "pill-stable", "sample": "sample/web/response.js", "notes": "Status/headers/body readers; deviation: new Response(stream) body not accepted — collect via reader" }, { "id": "api-headers", "m": "Headers", "s": "Stable", "c": "pill-stable", "sample": "sample/web/headers.js", "notes": "Case-insensitive multi-value map" }, { "id": "api-readablestream", "m": "ReadableStream", "s": "Stable", "c": "pill-stable", "sample": "sample/web/readablestream.js", "notes": "Enqueue and for-await collection" }, { "id": "api-writablestream", "m": "WritableStream", "s": "Stable", "c": "pill-stable", "sample": "sample/web/writablestream.js", "notes": "Write and close; pipeTo target" }, { "id": "api-transformstream", "m": "TransformStream", "s": "Stable", "c": "pill-stable", "sample": "sample/web/transformstream.js", "notes": "Chunk-in/chunk-out mapping" }, { "id": "api-compressionstream", "m": "CompressionStream", "s": "Stable", "c": "pill-stable", "sample": "sample/web/compression-stream.js", "notes": "gzip + deflate + winterjs2-extension zstd (ruzstd; encodes at Fastest)" }, { "id": "api-decompressionstream", "m": "DecompressionStream", "s": "Stable", "c": "pill-stable", "sample": "sample/web/decompression-stream.js", "notes": "Verified gzip/deflate/zstd round-trips" }, { "id": "api-crypto-webcrypto", "m": "crypto (WebCrypto)", "s": "Stable", "c": "pill-stable", "sample": "sample/web/webcrypto.js", "notes": "getRandomValues / randomUUID / subtle digest, AES-GCM, HMAC" }, { "id": "api-event", "m": "Event", "s": "Stable", "c": "pill-stable", "sample": "sample/web/event.js", "notes": "CustomEvent / MessageEvent / CloseEvent included" }, { "id": "api-eventtarget", "m": "EventTarget", "s": "Stable", "c": "pill-stable", "sample": "sample/web/eventtarget.js", "notes": "Subscribe / dispatch / once" }, { "id": "api-abortcontroller", "m": "AbortController", "s": "Stable", "c": "pill-stable", "sample": "sample/web/abortcontroller.js", "notes": "Abort operations via signal" }, { "id": "api-domexception", "m": "DOMException", "s": "Stable", "c": "pill-stable", "sample": "sample/web/domexception.js", "notes": "named errors (AbortError code 20)" }, { "id": "api-performance", "m": "performance", "s": "Stable", "c": "pill-stable", "sample": "sample/web/performance.js", "notes": "now / timeOrigin; also available as node:perf_hooks" }, { "id": "api-buffer", "m": "Buffer", "s": "Stable", "c": "pill-stable", "sample": "sample/web/buffer.js", "notes": "Deviation: isAscii/isUtf8/transcode absent; allocUnsafe is zero-filled" }, { "id": "api-websocket-client", "m": "WebSocket (client)", "s": "Experimental", "c": "pill-exp", "sample": "sample/web/websocket.js", "notes": "constructor shape offline; live echo via --serve, see sample/serve-hello/" }, { "id": "api-process", "m": "process", "s": "Stable", "c": "pill-stable", "sample": "sample/process/global.js", "notes": "Global process object: argv/env/versions/nextTick" }, { "id": "api-require", "m": "require", "s": "Stable", "c": "pill-stable", "sample": "sample/process/require.js", "notes": "CJS loading: exports/builtins/resolve" }, { "id": "api-module", "m": "module", "s": "Stable", "c": "pill-stable", "sample": "sample/process/module.js", "notes": "ESM import and require(esm) interop" }]
  core = [{ "id": "api-node-assert-strict", "m": "node:assert (+/strict)", "s": "Stable", "c": "pill-stable", "sample": "sample/assert/basics.js", "notes": "ok / equal / deepEqual / throws / rejects" }, { "id": "api-node-async-hooks", "m": "node:async_hooks", "s": "Stable", "c": "pill-stable", "sample": "sample/observe/basics.js", "notes": "AsyncLocalStorage run/getStore across timers" }, { "id": "api-node-buffer", "m": "node:buffer", "s": "Stable", "c": "pill-stable", "sample": "sample/web/buffer.js", "notes": "same class as global Buffer" }, { "id": "api-node-child-process", "m": "node:child_process", "s": "Stable", "c": "pill-stable", "sample": "sample/child-process/spawn.js", "notes": "spawnSync/execFileSync via process.execPath (cross-platform)" }, { "id": "api-node-cluster", "m": "node:cluster", "s": "Stable", "c": "pill-stable", "sample": "sample/cluster/primary-worker.js", "notes": "thread-based; fork / message / disconnect / exit" }, { "id": "api-node-console", "m": "node:console", "s": "Stable", "c": "pill-stable", "sample": "sample/web/console.js", "notes": "Console class over custom streams" }, { "id": "api-node-crypto", "m": "node:crypto", "s": "Stable", "c": "pill-stable", "sample": "sample/crypto/hash.js", "notes": "hash / HMAC / AES-GCM+CCM / ChaCha20 / ECDSA / Ed25519 / ECDH; CCM needs authTagLength" }, { "id": "api-node-domain", "m": "node:domain", "s": "Bridge", "c": "pill-bridge", "sample": "sample/observe/basics.js", "notes": "sync routing only; async not routed" }, { "id": "api-node-events", "m": "node:events", "s": "Stable", "c": "pill-stable", "sample": "sample/events/emitter.js", "notes": "on / once / off / error / maxListeners" }, { "id": "api-node-fs-promises", "m": "node:fs (+/promises)", "s": "Stable", "c": "pill-stable", "sample": "sample/fs/read-write.js", "notes": "sync / callback / promise / stream / watch faces" }, { "id": "api-node-module", "m": "node:module", "s": "Stable", "c": "pill-stable", "sample": "sample/module/main.mjs", "notes": "createRequire, builtin require" }, { "id": "api-node-os", "m": "node:os", "s": "Stable", "c": "pill-stable", "sample": "sample/os/info.js", "notes": "platform / arch / cpus / mem / user / uptime / net" }, { "id": "api-node-path-posix-win32", "m": "node:path (+/posix, +/win32)", "s": "Stable", "c": "pill-stable", "sample": "sample/path/basics.js", "notes": "join / resolve / parse / relative / extname" }, { "id": "api-node-process", "m": "node:process", "s": "Stable", "c": "pill-stable", "sample": "sample/process/basics.js", "notes": "argv / env / cwd / versions / hrtime / nextTick" }, { "id": "api-node-stream-promises-consumers-web", "m": "node:stream (+/promises, /consumers, /web)", "s": "Stable", "c": "pill-stable", "sample": "sample/stream/basics.js", "notes": "Readable / Writable / Transform / pipeline / finished / text / json" }, { "id": "api-node-string-decoder", "m": "node:string_decoder", "s": "Stable", "c": "pill-stable", "sample": "sample/codecs/string-decoder.js", "notes": "split multibyte decode" }, { "id": "api-node-querystring", "m": "node:querystring", "s": "Stable", "c": "pill-stable", "sample": "sample/codecs/querystring.js", "notes": "Query strings: parse/stringify/escape" }, { "id": "api-node-punycode", "m": "node:punycode", "s": "Stable", "c": "pill-stable", "sample": "sample/codecs/punycode.js", "notes": "IDNA: toASCII/toUnicode/ucs2" }, { "id": "api-node-sys", "m": "node:sys", "s": "Stable", "c": "pill-stable", "sample": "sample/util/basics.js", "notes": "deprecated alias, same object as node:util" }, { "id": "api-node-test", "m": "node:test", "s": "Stable", "c": "pill-stable", "sample": "sample/test-runner/basics.js", "notes": "describe / it; runs under --run and --test" }, { "id": "api-node-timers-promises", "m": "node:timers (+/promises)", "s": "Stable", "c": "pill-stable", "sample": "sample/url-timers/basics.js", "notes": "callback + promise faces" }, { "id": "api-node-util-types", "m": "node:util (+/types)", "s": "Stable", "c": "pill-stable", "sample": "sample/util/basics.js", "notes": "format / inspect / promisify / isMap / isPromise" }, { "id": "api-node-v8", "m": "node:v8", "s": "Bridge", "c": "pill-bridge", "sample": "sample/observe/basics.js", "notes": "only startupSnapshot; no heap statistics or serializer" }, { "id": "api-node-vm", "m": "node:vm", "s": "Stable", "c": "pill-stable", "sample": "sample/vm/basics.js", "notes": "Script / context / compileFunction; host globals not leaked" }, { "id": "api-node-worker-threads", "m": "node:worker_threads", "s": "Stable", "c": "pill-stable", "sample": "sample/worker-threads/main.mjs", "notes": "postMessage / terminate" }, { "id": "api-node-zlib", "m": "node:zlib", "s": "Stable", "c": "pill-stable", "sample": "sample/zlib/basics.js", "notes": "gzip / deflate / brotli / crc32" }]
  netio = [{ "id": "api-node-http", "m": "node:http", "s": "Stable", "c": "pill-stable", "sample": "sample/http/server-client.js", "notes": "keep-alive agent, streaming bodies" }, { "id": "api-node-http2", "m": "node:http2", "s": "Stable", "c": "pill-stable", "sample": "sample/http2/h2c.js", "notes": "h2c compat server + client session" }, { "id": "api-node-https", "m": "node:https", "s": "Stable", "c": "pill-stable", "sample": "sample/https/get.js", "notes": "Deviation: request listener currently fires twice per request — guard idempotently" }, { "id": "api-node-tls-tls-wrap", "m": "node:tls (+_tls_wrap)", "s": "Stable", "c": "pill-stable", "sample": "sample/tls/server-client.js", "notes": "fixture cert; _tls_wrap emits DEP0192" }, { "id": "api-node-net", "m": "node:net", "s": "Stable", "c": "pill-stable", "sample": "sample/net/tcp.js", "notes": "TCP echo; isIP / isIPv4 / isIPv6" }, { "id": "api-node-dgram", "m": "node:dgram", "s": "Stable", "c": "pill-stable", "sample": "sample/dgram/udp.js", "notes": "udp4 echo; multicast / connect supported" }, { "id": "api-node-dns-promises", "m": "node:dns (+/promises)", "s": "Stable", "c": "pill-stable", "sample": "sample/dns/lookup.js", "notes": "lookup(localhost) offline; full resolver via system DNS" }, { "id": "api-node-quic", "m": "node:quic", "s": "Experimental", "c": "pill-exp", "sample": "—", "notes": "listen/connect only; loopback handshake times out in this build" }, { "id": "api-node-diagnostics-channel", "m": "node:diagnostics_channel", "s": "Stable", "c": "pill-stable", "sample": "sample/observe/basics.js", "notes": "channel publish / subscribe" }, { "id": "api-node-inspector-promises", "m": "node:inspector (+/promises)", "s": "Bridge", "c": "pill-bridge", "sample": "sample/inspector/basics.js", "notes": "open/url/close lifecycle; no live debugging connection (url() stays undefined)" }, { "id": "api-node-trace-events", "m": "node:trace_events", "s": "Bridge", "c": "pill-bridge", "sample": "sample/trace-events/basics.js", "notes": "createTracing / enable / disable / getEnabledCategories" }, { "id": "api-node-tty", "m": "node:tty", "s": "Stable", "c": "pill-stable", "sample": "sample/observe/basics.js", "notes": "isatty / ReadStream / WriteStream" }, { "id": "api-node-readline", "m": "node:readline", "s": "Stable", "c": "pill-stable", "sample": "sample/readline/basics.js", "notes": "no terminal needed" }, { "id": "api-node-repl", "m": "node:repl", "s": "Stable", "c": "pill-stable", "sample": "sample/repl/basics.js", "notes": "no terminal needed; Recoverable" }, { "id": "api-node-url-legacy", "m": "node:url (legacy)", "s": "Stable", "c": "pill-stable", "sample": "sample/url-timers/basics.js", "notes": "parse / format / resolve / Url class" }, { "id": "api-node-perf-hooks", "m": "node:perf_hooks", "s": "Stable", "c": "pill-stable", "sample": "sample/observe/basics.js", "notes": "performance object" }, { "id": "api-node-sqlite", "m": "node:sqlite", "s": "Stable", "c": "pill-stable", "sample": "sample/sqlite/basics.js", "notes": "DatabaseSync backed by turso storage, verified in-memory" }]
  deno = [{ "id": "api-deno", "m": "Deno", "s": "Stable", "c": "pill-stable", "sample": "sample/winterjs2/namespaces.js", "notes": "frozen namespace: files/env/network/serve/Command/test, same behavior as the node: modules" }]
  bun = [{ "id": "api-bun-ffi", "m": "bun:ffi", "s": "Experimental", "c": "pill-exp", "sample": "sample/bun-ffi/strlen.js", "notes": "dlopen libc strlen (darwin/linux guarded); ptr/CString address model" }, { "id": "api-bun-sqlite", "m": "bun:sqlite", "s": "Stable", "c": "pill-stable", "sample": "sample/sqlite/basics.js", "notes": "Database backed by turso storage, verified in-memory" }, { "id": "api-bun", "m": "Bun", "s": "Stable", "c": "pill-stable", "sample": "sample/winterjs2/namespaces.js", "notes": "file/write/spawn/serve/sleep/shell; version/argv/env mirror process" }]
  wjs = [{ "id": "api-storage-localstorage", "m": "storage / localStorage", "s": "Stable", "c": "pill-stable", "sample": "sample/storage/basics.js", "notes": "WinterCG own KV (turso single file, --storage-path); async get/set/delete/has/keys/clear/size + sync localStorage; inspect via -b/--db (+WinterJS2.* alias)" }, { "id": "api-winterjs2-image", "m": "WinterJS2.image", "s": "Stable", "c": "pill-stable", "sample": "sample/winterjs2/image.js", "notes": "decode to RGBA8 / encode back: png/jpeg/gif/webp/tiff/tga/bmp/ico/hdr/exr/pnm/farbfeld/qoi + svg/jxl decode-only; quality params pass through" }, { "id": "api-winterjs2", "m": "WinterJS2", "s": "Stable", "c": "pill-stable", "sample": "sample/winterjs2/namespaces.js", "notes": "runtime namespace: version/args/env/storage + image; see also Deno and Bun" }, { "id": "api-winterjs2-fs", "m": "fs / WinterJS2.fs", "s": "Stable", "c": "pill-stable", "sample": "sample/wfs/basics.js", "notes": "Own file surface, separate from node:fs (direct fs-err); async readFile/readTextFile/writeFile/writeTextFile/stat/mkdir/readdir/remove/rename/copyFile/exists" }, { "id": "api-winterjs2-memory", "m": "WinterJS2.memory/alloc/unsafe*", "s": "Stable", "c": "pill-stable", "sample": "sample/mem/basics.js", "notes": "memory() rss+allocator; alloc(n) GC-managed zero-filled Uint8Array; unsafeAlloc/Write/Read/Size/Free/List manual id heap behind --allow-ffi" }, { "id": "api-winterjs2-semver", "m": "WinterJS2.semver", "s": "Stable", "c": "pill-stable", "sample": "sample/wstd/semver.js", "notes": "Version validation, ranges and parsing" }, { "id": "api-winterjs2-yaml", "m": "WinterJS2.yaml", "s": "Stable", "c": "pill-stable", "sample": "sample/wstd/yaml.js", "notes": "YAML parsing and serialization" }, { "id": "api-winterjs2-jsonc", "m": "WinterJS2.jsonc", "s": "Stable", "c": "pill-stable", "sample": "sample/wstd/jsonc.js", "notes": "Comment- and trailing-comma-tolerant JSON" }, { "id": "api-winterjs2-ip", "m": "WinterJS2.ip", "s": "Stable", "c": "pill-stable", "sample": "sample/wstd/ip.js", "notes": "CIDR containment and parsing" }, { "id": "api-winterjs2-shlex", "m": "WinterJS2.shlex", "s": "Stable", "c": "pill-stable", "sample": "sample/wstd/shlex.js", "notes": "Shell word splitting" }, { "id": "api-winterjs2-spdx", "m": "WinterJS2.spdx", "s": "Stable", "c": "pill-stable", "sample": "sample/wstd/spdx.js", "notes": "SPDX license expression validation" }, { "id": "api-winterjs2-qrcode", "m": "WinterJS2.qrcode", "s": "Stable", "c": "pill-stable", "sample": "sample/wstd/qrcode.js", "notes": "Terminal QR code rendering" }, { "id": "api-winterjs2-shell", "m": "WinterJS2.shell", "s": "Stable", "c": "pill-stable", "sample": "sample/wsys/shell.js", "notes": "Shell-ish expansion: ~ and $VAR through the env gate" }, { "id": "api-winterjs2-hex", "m": "WinterJS2.hex", "s": "Stable", "c": "pill-stable", "sample": "sample/wsys/hex.js", "notes": "Hex codec between strings and bytes" }, { "id": "api-winterjs2-time", "m": "WinterJS2.time", "s": "Stable", "c": "pill-stable", "sample": "sample/wsys/time.js", "notes": "Millisecond clock, ISO parsing and formatting" }, { "id": "api-winterjs2-retry", "m": "WinterJS2.retry", "s": "Stable", "c": "pill-stable", "sample": "sample/wsys/retry.js", "notes": "Backoff delays and the run loop" }, { "id": "api-winterjs2-graph", "m": "WinterJS2.graph", "s": "Stable", "c": "pill-stable", "sample": "sample/wsys/graph.js", "notes": "Directed graphs: nodes/edges, topological sort" }, { "id": "api-winterjs2-git", "m": "WinterJS2.git", "s": "Stable", "c": "pill-stable", "sample": "sample/wsys/git.js", "notes": "Read-only git: rev parsing and log" }, { "id": "api-winterjs2-oauth", "m": "WinterJS2.oauth", "s": "Stable", "c": "pill-stable", "sample": "sample/wsys/oauth.js", "notes": "Authorization URL building and PKCE" }, { "id": "api-winterjs2-transpile", "m": "WinterJS2.transpile", "s": "Stable", "c": "pill-stable", "sample": "sample/wsys/transpile.js", "notes": "TypeScript type-stripping transpile" }, { "id": "api-winterjs2-log", "m": "WinterJS2.log", "s": "Stable", "c": "pill-stable", "sample": "sample/wsys/log.js", "notes": "Structured logging: debug/info/warn/error" }, { "id": "api-winterjs2-mime", "m": "WinterJS2.mime", "s": "Stable", "c": "pill-stable", "sample": "sample/wsys/mime.js", "notes": "Extension-to-MIME lookup" }, { "id": "api-winterjs2-cookie", "m": "WinterJS2.cookie", "s": "Stable", "c": "pill-stable", "sample": "sample/wsys/cookie.js", "notes": "Cookie parsing and serialization" }, { "id": "api-winterjs2-httpdate", "m": "WinterJS2.httpdate", "s": "Stable", "c": "pill-stable", "sample": "sample/wsys/httpdate.js", "notes": "HTTP-date parsing and formatting" }, { "id": "api-winterjs2-assert", "m": "WinterJS2.assert", "s": "Stable", "c": "pill-stable", "sample": "sample/wcover/assert.js", "notes": "Structured assertions with AssertionError" }, { "id": "api-winterjs2-util", "m": "WinterJS2.util", "s": "Stable", "c": "pill-stable", "sample": "sample/wcover/util.js", "notes": "Printf-style format and object inspect" }, { "id": "api-winterjs2-punycode", "m": "WinterJS2.punycode", "s": "Stable", "c": "pill-stable", "sample": "sample/wcover/punycode.js", "notes": "Two-way IDNA conversion" }, { "id": "api-winterjs2-tcp", "m": "WinterJS2.tcp", "s": "Stable", "c": "pill-stable", "sample": "sample/wcover/tcp.js", "notes": "Loopback TCP echo; byte streams are async-iterable" }, { "id": "api-winterjs2-udp", "m": "WinterJS2.udp", "s": "Stable", "c": "pill-stable", "sample": "sample/wcover/udp.js", "notes": "Loopback UDP datagrams" }, { "id": "api-winterjs2-dns", "m": "WinterJS2.dns", "s": "Stable", "c": "pill-stable", "sample": "sample/wcover/dns.js", "notes": "DNS lookups (localhost resolves offline)" }, { "id": "api-winterjs2-tls", "m": "WinterJS2.tls", "s": "Stable", "c": "pill-stable", "sample": "sample/wcover/tls.js", "notes": "Loopback TLS client (self-signed sample cert)" }, { "id": "api-winterjs2-command", "m": "WinterJS2.command", "s": "Stable", "c": "pill-stable", "sample": "sample/wcover/command.js", "notes": "Run and supervise child processes, captured or streamed (needs --allow-run)" }, { "id": "api-winterjs2-terminal", "m": "WinterJS2.terminal", "s": "Stable", "c": "pill-stable", "sample": "sample/wcover/terminal.js", "notes": "Line-editing interface face" }, { "id": "api-winterjs2-repl", "m": "WinterJS2.repl", "s": "Stable", "c": "pill-stable", "sample": "sample/wcover/repl.js", "notes": "REPL server face" }, { "id": "api-worker", "m": "Worker", "s": "Stable", "c": "pill-stable", "sample": "sample/wcover/worker.js", "notes": "Web Worker threads with JSON messaging" }, { "id": "api-winterjs2-cluster", "m": "WinterJS2.cluster", "s": "Stable", "c": "pill-stable", "sample": "sample/wcover/cluster.js", "notes": "Primary/worker faces" }, { "id": "api-winterjs2-test", "m": "WinterJS2.test", "s": "Stable", "c": "pill-stable", "sample": "sample/wcover/test.js", "notes": "Built-in test runner face" }, { "id": "api-winterjs2-vm", "m": "WinterJS2.vm", "s": "Stable", "c": "pill-stable", "sample": "sample/wcover/vm.js", "notes": "Script evaluation face" }, { "id": "api-winterjs2-os", "m": "WinterJS2.os", "s": "Stable", "c": "pill-stable", "sample": "sample/wcover/os.js", "notes": "Operating system facts" }, { "id": "api-winterjs2-path", "m": "WinterJS2.path", "s": "Stable", "c": "pill-stable", "sample": "sample/wcover/path.js", "notes": "Path utilities" }, { "id": "api-winterjs2-db", "m": "WinterJS2.db", "s": "Stable", "c": "pill-stable", "sample": "sample/wcover/db.js", "notes": "Embedded SQL database" }, { "id": "api-winterjs2-inspect", "m": "WinterJS2.inspect", "s": "Stable", "c": "pill-stable", "sample": "sample/wcover/inspect.js", "notes": "Expression evaluator" }, { "id": "api-winterjs2-tty", "m": "WinterJS2.tty", "s": "Stable", "c": "pill-stable", "sample": "sample/wcover/tty.js", "notes": "Terminal checks" }, { "id": "api-winterjs2-stream", "m": "WinterJS2.stream", "s": "Stable", "c": "pill-stable", "sample": "sample/wcover/stream.js", "notes": "Stream pipelining" }, { "id": "api-winterjs2-serve", "m": "WinterJS2.serve", "s": "Stable", "c": "pill-stable", "sample": "sample/wcover/serve.js", "notes": "Static-plus-dynamic HTTP serving" }, { "id": "api-winterjs2-diagnostics", "m": "WinterJS2.diagnostics", "s": "Stable", "c": "pill-stable", "sample": "sample/wcover/diagnostics.js", "notes": "Diagnostic channel publish/subscribe" }, { "id": "api-winterjs2-domain", "m": "WinterJS2.domain", "s": "Stable", "c": "pill-stable", "sample": "sample/wcover/domain.js", "notes": "Synchronous error routing" }, { "id": "api-winterjs2-trace", "m": "WinterJS2.trace", "s": "Stable", "c": "pill-stable", "sample": "sample/wcover/trace.js", "notes": "Tracing categories" }, { "id": "api-winterjs2-asynclocalstorage", "m": "WinterJS2.AsyncLocalStorage", "s": "Stable", "c": "pill-stable", "sample": "sample/wcover/asynclocalstorage.js", "notes": "Context across timers" }, { "id": "api-winterjs2-quic", "m": "WinterJS2.quic", "s": "Experimental", "c": "pill-exp", "sample": "sample/wcover/quic.js", "notes": "Interface only; loopback handshake unsupported in this build" }, { "id": "api-winterjs2-crypto", "m": "WinterJS2.crypto", "s": "Stable", "c": "pill-stable", "sample": "sample/wcover/crypto.js", "notes": "WebCrypto alias face" }, { "id": "api-winterjs2-ffi", "m": "WinterJS2.ffi", "s": "Experimental", "c": "pill-exp", "sample": "sample/wcover/ffi.js", "notes": "bun:ffi alias face; deviation: WinterJS2.ffi is always null in this build, import bun:ffi directly (needs --allow-ffi)" }, { "id": "api-winterjs2-media", "m": "WinterJS2.media", "s": "Stable", "c": "pill-stable", "sample": "sample/media/basics.js", "notes": "audio decode/play (symphonia/rodio) + AV1 encode (rav1e, IVF) + MP4 demux (mp4-rs); PCM f32, quality params pass through" }]

template:
  h1 winterjs2 API Reference
  blockquote Style follows #[a(href='https://nodejs.org/docs/latest/api/') nodejs.org/api]: one section per module, stability marker, import form, sample link, and #[strong known deviations] (verified against #[code winterjs2 --run sample/...], 2026-09-27). 中文版见 #[a(href='#/zh/api') API 参考].
  p Stability: #[span.pill.pill-stable Stable] tracks Node semantics; #[span.pill.pill-exp Experimental] present but evolving; #[span.pill.pill-bridge Bridge] intentionally reduced surface.
  p Quick runnable index: every row has a sample under #[code sample/&lt;area&gt;/].
  h2 WinterJS2 native · WinterJS2 原生
  table
    thead
      tr
        th API
        th Stability
        th Sample
        th Notes
    tbody
      each n in wjs
        tr(id=n.id)
          td: code= n.m
          td: span.pill(class=n.c)= n.s
          td
            if n.sample == '—'
              | —
            else
              button.sample-link(type='button' data-sample=n.sample title='preview source')= n.sample
          td!= n.notes
  h2 Web globals (no import)
  table
    thead
      tr
        th Global
        th Stability
        th Sample
        th Notes
    tbody
      each g in web
        tr(id=g.id)
          td: code= g.m
          td: span.pill(class=g.c)= g.s
          td
            if g.sample == '—'
              | —
            else
              button.sample-link(type='button' data-sample=g.sample title='preview source')= g.sample
          td!= g.notes
  h2 node: modules — core
  table
    thead
      tr
        th Module
        th Stability
        th Sample
        th Notes
    tbody
      each m in core
        tr(id=m.id)
          td: code= m.m
          td: span.pill(class=m.c)= m.s
          td
            if m.sample == '—'
              | —
            else
              button.sample-link(type='button' data-sample=m.sample title='preview source')= m.sample
          td!= m.notes
  h2 node: modules — network &amp; I/O
  table
    thead
      tr
        th Module
        th Stability
        th Sample
        th Notes
    tbody
      each m in netio
        tr(id=m.id)
          td: code= m.m
          td: span.pill(class=m.c)= m.s
          td
            if m.sample == '—'
              | —
            else
              button.sample-link(type='button' data-sample=m.sample title='preview source')= m.sample
          td!= m.notes
  h2 Bun compatibility · Bun 兼容
  table
    thead
      tr
        th API
        th Stability
        th Sample
        th Notes
    tbody
      each b in bun
        tr(id=b.id)
          td: code= b.m
          td: span.pill(class=b.c)= b.s
          td
            if b.sample == '—'
              | —
            else
              button.sample-link(type='button' data-sample=b.sample title='preview source')= b.sample
          td!= b.notes
  h2 Deno compatibility · Deno 兼容
  table
    thead
      tr
        th API
        th Stability
        th Sample
        th Notes
    tbody
      each d in deno
        tr(id=d.id)
          td: code= d.m
          td: span.pill(class=d.c)= d.s
          td
            if d.sample == '—'
              | —
            else
              button.sample-link(type='button' data-sample=d.sample title='preview source')= d.sample
          td!= d.notes
  h2 Not supported (by design)
  ul
    li #[code wasi], #[code sea] — no equivalent planned.
    li N-API native addons (#[code .node]) load via the napi surface, but writing C addons against winterjs2 headers is out of scope for these samples.
  h2 Errors &amp; warnings
  ul
    li Uncaught errors render Node-style (#[code file:line], source line, #[code ^], #[code Name: message], #[code at] stack) with exit 1; #[code throw &lt;non-Error&gt;] prints the value.
    li #[code process.emitWarning] dispatches asynchronously (nextTick), matching Node.
