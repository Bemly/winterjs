coffee:
  # NOTE (luolita 0.1.4): bridged data must be single-line valid JSON.
  web = [{ "m": "console", "s": "稳定", "c": "pill-stable", "sample": "sample/web/console.js", "notes": "log/info/warn/error/time/count/dir；node:console 导出自定义流的 Console 类" }, { "m": "定时器", "s": "稳定", "c": "pill-stable", "sample": "sample/web/timers.js", "notes": "setTimeout/Interval/Immediate + queueMicrotask；setImmediate 不钳 1ms" }, { "m": "structuredClone", "s": "实验", "c": "pill-exp", "sample": "sample/web/structured-clone.js", "notes": "偏离：仅纯数据——Date/Map/Set/正则/类型化数组回来都是普通对象" }, { "m": "URL / URLSearchParams / URLPattern", "s": "稳定", "c": "pill-stable", "sample": "sample/web/url.js", "notes": "WHATWG；legacy url.parse/format 在 node:url" }, { "m": "TextEncoder / TextDecoder / atob / btoa", "s": "稳定", "c": "pill-stable", "sample": "sample/web/url.js", "notes": "支持 fatal:true" }, { "m": "Blob / File", "s": "稳定", "c": "pill-stable", "sample": "sample/web/blob-file.js", "notes": "slice / text / arrayBuffer" }, { "m": "fetch / Request / Response / Headers", "s": "稳定", "c": "pill-stable", "sample": "sample/web/fetch.js", "notes": "data: URL 离线可用；流式体走 Web Streams" }, { "m": "ReadableStream / WritableStream / TransformStream", "s": "稳定", "c": "pill-stable", "sample": "sample/web/streams.js", "notes": "支持 for-await；偏离：new Response(可读流) 体不接受——用 reader 收集" }, { "m": "CompressionStream / DecompressionStream", "s": "稳定", "c": "pill-stable", "sample": "sample/web/compression.js", "notes": "gzip + deflate 已验往返" }, { "m": "crypto (WebCrypto)", "s": "稳定", "c": "pill-stable", "sample": "sample/web/webcrypto.js", "notes": "getRandomValues / randomUUID / subtle 摘要、AES-GCM、HMAC" }, { "m": "Event / EventTarget / AbortController", "s": "稳定", "c": "pill-stable", "sample": "sample/web/events.js", "notes": "含 CustomEvent / MessageEvent / CloseEvent" }, { "m": "DOMException", "s": "稳定", "c": "pill-stable", "sample": "sample/web/events.js", "notes": "具名错误（AbortError 码 20）" }, { "m": "performance", "s": "稳定", "c": "pill-stable", "sample": "sample/web/performance.js", "notes": "now / timeOrigin；node:perf_hooks 同源再导出" }, { "m": "Buffer", "s": "稳定", "c": "pill-stable", "sample": "sample/web/buffer.js", "notes": "偏离：无 isAscii/isUtf8/transcode；allocUnsafe 恒零填" }, { "m": "WebSocket（客户端）", "s": "实验", "c": "pill-exp", "sample": "sample/web/websocket.js", "notes": "构造形态离线可验；live 回声走 --serve，见 sample/serve-hello/" }, { "m": "process / require / module", "s": "稳定", "c": "pill-stable", "sample": "sample/process/basics.js", "notes": "CJS + ESM 互操作；支持 require(esm)" }]
  core = [{ "m": "node:assert（+/strict）", "s": "稳定", "c": "pill-stable", "sample": "sample/assert/basics.js", "notes": "ok / equal / deepEqual / throws / rejects" }, { "m": "node:async_hooks", "s": "稳定", "c": "pill-stable", "sample": "sample/observe/basics.js", "notes": "AsyncLocalStorage 跨定时器透传" }, { "m": "node:buffer", "s": "稳定", "c": "pill-stable", "sample": "sample/web/buffer.js", "notes": "与全局 Buffer 同一类" }, { "m": "node:child_process", "s": "稳定", "c": "pill-stable", "sample": "sample/child-process/spawn.js", "notes": "经 process.execPath 自举（跨平台）" }, { "m": "node:cluster", "s": "稳定", "c": "pill-stable", "sample": "sample/cluster/primary-worker.js", "notes": "线程底座；fork / message / disconnect / exit" }, { "m": "node:console", "s": "稳定", "c": "pill-stable", "sample": "sample/web/console.js", "notes": "Console 类" }, { "m": "node:crypto", "s": "稳定", "c": "pill-stable", "sample": "sample/crypto/hash.js", "notes": "哈希 / HMAC / AES-GCM+CCM / ChaCha20 / ECDSA / Ed25519 / ECDH；CCM 需 authTagLength" }, { "m": "node:domain", "s": "桥接", "c": "pill-bridge", "sample": "sample/observe/basics.js", "notes": "仅同步路由；异步不路由" }, { "m": "node:events", "s": "稳定", "c": "pill-stable", "sample": "sample/events/emitter.js", "notes": "on / once / off / error / 上限" }, { "m": "node:fs（+/promises）", "s": "稳定", "c": "pill-stable", "sample": "sample/fs/read-write.js", "notes": "同步 / 回调 / Promise / 流 / 监听全家" }, { "m": "node:module", "s": "稳定", "c": "pill-stable", "sample": "sample/module/main.mjs", "notes": "createRequire、内建 require" }, { "m": "node:os", "s": "稳定", "c": "pill-stable", "sample": "sample/os/info.js", "notes": "平台 / 架构 / CPU / 内存 / 用户 / 时长 / 网卡" }, { "m": "node:path（+/posix, +/win32）", "s": "稳定", "c": "pill-stable", "sample": "sample/path/basics.js", "notes": "join / resolve / parse / relative / extname" }, { "m": "node:process", "s": "稳定", "c": "pill-stable", "sample": "sample/process/basics.js", "notes": "参数 / 环境 / 版本 / 高精度时间 / nextTick" }, { "m": "node:stream（+/promises, /consumers, /web）", "s": "稳定", "c": "pill-stable", "sample": "sample/stream/basics.js", "notes": "四类流 / pipeline / finished / text / json" }, { "m": "node:string_decoder", "s": "稳定", "c": "pill-stable", "sample": "sample/codecs/basics.js", "notes": "跨包多字节解码" }, { "m": "node:querystring / node:punycode", "s": "稳定", "c": "pill-stable", "sample": "sample/codecs/basics.js", "notes": "parse / stringify / escape；toASCII / toUnicode" }, { "m": "node:sys", "s": "稳定", "c": "pill-stable", "sample": "sample/util/basics.js", "notes": "废弃别名，与 node:util 同实例" }, { "m": "node:test", "s": "稳定", "c": "pill-stable", "sample": "sample/test-runner/basics.js", "notes": "describe / it，--run 与 --test 下都跑" }, { "m": "node:timers（+/promises）", "s": "稳定", "c": "pill-stable", "sample": "sample/url-timers/basics.js", "notes": "回调 + Promise 双形态" }, { "m": "node:util（+/types）", "s": "稳定", "c": "pill-stable", "sample": "sample/util/basics.js", "notes": "format / inspect / promisify / isMap / isPromise" }, { "m": "node:v8", "s": "桥接", "c": "pill-bridge", "sample": "sample/observe/basics.js", "notes": "仅 startupSnapshot；堆统计有意缺席" }, { "m": "node:vm", "s": "稳定", "c": "pill-stable", "sample": "sample/vm/basics.js", "notes": "Script / 上下文 / compileFunction；宿主全局不泄漏" }, { "m": "node:worker_threads", "s": "稳定", "c": "pill-stable", "sample": "sample/worker-threads/main.mjs", "notes": "postMessage / terminate" }, { "m": "node:zlib", "s": "稳定", "c": "pill-stable", "sample": "sample/zlib/basics.js", "notes": "gzip / deflate / brotli / crc32" }]
  netio = [{ "m": "node:http", "s": "稳定", "c": "pill-stable", "sample": "sample/http/server-client.js", "notes": "keep-alive 复用、流式体" }, { "m": "node:http2", "s": "稳定", "c": "pill-stable", "sample": "sample/http2/h2c.js", "notes": "h2c 兼容服务 + 客户端会话" }, { "m": "node:https", "s": "稳定", "c": "pill-stable", "sample": "sample/https/get.js", "notes": "偏离：单请求目前派发两次 request 监听——请幂等守卫" }, { "m": "node:tls（+_tls_wrap）", "s": "稳定", "c": "pill-stable", "sample": "sample/tls/server-client.js", "notes": "样例自签证书；_tls_wrap 报 DEP0192" }, { "m": "node:net", "s": "稳定", "c": "pill-stable", "sample": "sample/net/tcp.js", "notes": "TCP 回声；isIP / isIPv4 / isIPv6" }, { "m": "node:dgram", "s": "稳定", "c": "pill-stable", "sample": "sample/dgram/udp.js", "notes": "udp4 回声；支持组播 / connect" }, { "m": "node:dns（+/promises）", "s": "稳定", "c": "pill-stable", "sample": "sample/dns/lookup.js", "notes": "lookup(localhost) 离线可用；全 resolver 读系统 DNS" }, { "m": "node:quic", "s": "实验", "c": "pill-exp", "sample": "—", "notes": "仅 listen/connect 形态面；本构建回环握手超时" }, { "m": "node:diagnostics_channel", "s": "稳定", "c": "pill-stable", "sample": "sample/observe/basics.js", "notes": "通道发布订阅" }, { "m": "node:inspector（+/promises）", "s": "桥接", "c": "pill-bridge", "sample": "sample/inspector/basics.js", "notes": "open/url/close 生命周期；无线上通道（url() 恒 undefined）" }, { "m": "node:trace_events", "s": "桥接", "c": "pill-bridge", "sample": "sample/trace-events/basics.js", "notes": "createTracing / enable / disable / getEnabledCategories" }, { "m": "node:tty", "s": "稳定", "c": "pill-stable", "sample": "sample/observe/basics.js", "notes": "isatty / ReadStream / WriteStream" }, { "m": "node:readline", "s": "稳定", "c": "pill-stable", "sample": "sample/readline/basics.js", "notes": "内存流驱动，无需 TTY" }, { "m": "node:repl", "s": "稳定", "c": "pill-stable", "sample": "sample/repl/basics.js", "notes": "内存流驱动（免 TTY）；Recoverable" }, { "m": "bun:ffi", "s": "实验", "c": "pill-exp", "sample": "sample/bun-ffi/strlen.js", "notes": "dlopen 调 libc strlen（darwin/linux 守卫）；ptr/CString 地址模型" }, { "m": "node:sqlite / bun:sqlite", "s": "稳定", "c": "pill-stable", "sample": "sample/sqlite/basics.js", "notes": "DatabaseSync / Database，内存库已验" }, { "m": "node:url（legacy）", "s": "稳定", "c": "pill-stable", "sample": "sample/url-timers/basics.js", "notes": "parse / format / resolve / Url 类" }, { "m": "node:perf_hooks", "s": "稳定", "c": "pill-stable", "sample": "sample/observe/basics.js", "notes": "performance 对象" }]

template:
  h1 winterjs API 参考
  blockquote 体例对标 #[a(href='https://nodejs.org/docs/latest/api/') nodejs.org/api]：每模块一节，标注稳定性，给出导入形态、链接样例，并列出#[strong 已知偏离]（2026-09-27 经 #[code winterjs --run sample/...] 逐项实测）。English version: #[a(href='#/en/api') API reference].
  p 稳定性：#[span.pill.pill-stable 稳定] 跟随 Node 语义；#[span.pill.pill-exp 实验] 可用但在演进；#[span.pill.pill-bridge 桥接] 有意裁剪的面。
  p 可运行索引：每行对应 #[code sample/&lt;领域&gt;/] 下的样例。
  h2 Web 全局（免导入）
  table
    thead
      tr
        th 全局
        th 稳定性
        th 样例
        th 说明
    tbody
      each g in web
        tr
          td: code= g.m
          td: span.pill(class=g.c)= g.s
          td
            if g.sample == '—'
              | —
            else
              button.sample-link(type='button' data-sample=g.sample title='预览源码')= g.sample
          td!= g.notes
  h2 node: 模块——核心
  table
    thead
      tr
        th 模块
        th 稳定性
        th 样例
        th 说明
    tbody
      each m in core
        tr
          td: code= m.m
          td: span.pill(class=m.c)= m.s
          td
            if m.sample == '—'
              | —
            else
              button.sample-link(type='button' data-sample=m.sample title='预览源码')= m.sample
          td!= m.notes
  h2 node: 模块——网络与 I/O
  table
    thead
      tr
        th 模块
        th 稳定性
        th 样例
        th 说明
    tbody
      each m in netio
        tr
          td: code= m.m
          td: span.pill(class=m.c)= m.s
          td
            if m.sample == '—'
              | —
            else
              button.sample-link(type='button' data-sample=m.sample title='预览源码')= m.sample
          td!= m.notes
  h2 不做（设计如此）
  ul
    li #[code wasi]、#[code sea] —— 无对等计划。
    li N-API 原生 addon（#[code .node]）可经 napi 面加载，但针对 winterjs 头写 C addon 不在样例范围。
  h2 错误与警告
  ul
    li 未捕获错误按 node 形渲染（#[code 文件:行]、源码行、#[code ^]、#[code 名: 消息]、#[code at] 栈），exit=1；#[code throw &lt;非 Error&gt;] 打印值本身。
    li #[code process.emitWarning] 异步派发（nextTick），与 Node 一致。
