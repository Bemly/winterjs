coffee:
  # NOTE (luolita 0.1.4): bridged data must be single-line valid JSON.
  rules = [{ "text": "一次恰好一个动作：--run a.js --eval 1 直接报错。" }, { "text": "无裸子命令/无裸位置参数：winterjs2 a.js 是错的，写 --run a.js；脚本自己的参数放 -- 之后：winterjs2 --run app.js -- --port 8080。" }, { "text": "修饰 flag 只在对应动作下生效：--port 只配 --serve，--filter 只配 --test，--watch 配 --test/--run/--serve，--schema 只配 --config，--allow-* 只配 --run/--eval/--test/--repl。配错 exit=1。" }]

template:
  h1 winterjs2 快速上手
  blockquote 5 分钟从零跑起 JS。English version: #[a(href='#/en/quickstart') Quickstart].
  h2 1. 构建与验证
  pre
    code.
      $ cargo build
      $ export SDKROOT="$(xcrun --show-sdk-path)"          # macOS，每个新 shell 都要
      $ export LIBCLANG_PATH="/opt/homebrew/opt/llvm/lib"
      $ export PATH="/opt/homebrew/opt/llvm/bin:$PATH"
      $ ./target/debug/winterjs2 --eval '40 + 2'            # → 42
  h2 2. 跑文件、求值、进 REPL
  pre
    code.
      $ ./target/debug/winterjs2 --run sample/web/timers.js  # 跑 JS 文件并打印完成值
      $ ./target/debug/winterjs2 --eval 'await Promise.resolve(7)'  # → 7
      $ ./target/debug/winterjs2 --repl                       # 交互式 REPL（Ctrl-D 退出）
  p 规矩（详见 #[a(href='#/zh/cli') CLI 参考]）：
  ul
    each r in rules
      li= r.text
  h2 REPL 速查
  pre
    code.
      $ ./target/debug/winterjs2                       # 裸启动也进 REPL
      ❄&gt; WinterJS2. + Tab                           # 补全 WinterJS2.* 并附右侧文档
      ❄&gt; .doc WinterJS2.fs.readFile                 # 任意主题看整篇文档
      ❄&gt; await fetch("data:text/plain,hi").then((r) => r.text())  # 顶层 await 可用
      ❄&gt; .help / .exit                             # 帮助、退出（.quit、exit()、Ctrl-D 同）
  p Tab 出补全菜单 + 右侧文档；括号未闭合自动续行；2 秒内连按两次 Ctrl-C 退出。
  h2 3. 用 Node API 与 Web 全局
  pre
    code.
      // hello.mjs —— ESM，下例 Web 全局与 node: 导入混用
      import { readFileSync } from 'node:fs';
      import path from 'node:path';

      const text = readFileSync(new URL('./hello.mjs', import.meta.url), 'utf8');
      console.log('self bytes:', new TextEncoder().encode(text).length);
      console.log('join:', path.join('a', 'b'));
      const res = await fetch('data:text/plain,hi');
      console.log(await res.text()); // hi
  pre
    code.
      $ ./target/debug/winterjs2 --run hello.mjs
  p CommonJS 同样可用（#[code require]、#[code module.exports]、#[code __dirname]）。
  h2 4. 测试、lint、格式化与 serve
  pre
    code.
      $ ./target/debug/winterjs2 --test sample/test-runner/   # 发现并跑测试文件
      $ ./target/debug/winterjs2 --test sample/test-runner/ --filter 'basics*'
      $ ./target/debug/winterjs2 --test sample/test-runner/ --watch   # 变更重跑（Ctrl-C 停止）
      $ ./target/debug/winterjs2 --lint -- --help              # 原样转发给 oxlint
      $ ./target/debug/winterjs2 --fmt                         # 转发给 oxfmt
      $ ./target/debug/winterjs2 --serve sample/serve-hello/public --port 8080 \
          --handler sample/serve-hello/handler.mjs            # 静态 + 动态 fetch + WS
  h2 5. 下一步
  ul
    li #[a(href='#/zh/api') API 参考] —— 全部模块、稳定性与已知偏离。
    li #[a(href='#/zh/cli') CLI 参考] —— 全 flag 参考（含动作归属）。
    li #[code sample/&lt;领域&gt;/*.js] —— 128 个可运行样例，每个模块一件。
