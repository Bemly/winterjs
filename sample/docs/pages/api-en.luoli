coffee:
  # NOTE (luolita 0.1.4): bridged data must be single-line valid JSON.
  web = [{ "m": "console", "s": "Stable", "c": "pill-stable", "sample": "sample/web/console.js", "notes": "log/info/warn/error/time/count/dir; node:console exports the Console class" }, { "m": "timers", "s": "Stable", "c": "pill-stable", "sample": "sample/web/timers.js", "notes": "setTimeout/Interval/Immediate + queueMicrotask; setImmediate is not clamped to 1ms" }, { "m": "structuredClone", "s": "Experimental", "c": "pill-exp", "sample": "sample/web/structured-clone.js", "notes": "Deviation: plain data only — Date/Map/Set/RegExp/TypedArray come back as plain objects" }, { "m": "URL / URLSearchParams / URLPattern", "s": "Stable", "c": "pill-stable", "sample": "sample/web/url.js", "notes": "WHATWG; legacy url.parse/format lives in node:url" }, { "m": "TextEncoder / TextDecoder / atob / btoa", "s": "Stable", "c": "pill-stable", "sample": "sample/web/url.js", "notes": "fatal:true supported" }, { "m": "Blob / File", "s": "Stable", "c": "pill-stable", "sample": "sample/web/blob-file.js", "notes": "slice / text / arrayBuffer" }, { "m": "fetch / Request / Response / Headers", "s": "Stable", "c": "pill-stable", "sample": "sample/web/fetch.js", "notes": "data: URLs work offline; streaming bodies via Web Streams" }, { "m": "ReadableStream / WritableStream / TransformStream", "s": "Stable", "c": "pill-stable", "sample": "sample/web/streams.js", "notes": "for-await consumption. Deviation: new Response(stream) body not accepted — collect via reader" }, { "m": "CompressionStream / DecompressionStream", "s": "Stable", "c": "pill-stable", "sample": "sample/web/compression.js", "notes": "gzip + deflate verified round-trips" }, { "m": "crypto (WebCrypto)", "s": "Stable", "c": "pill-stable", "sample": "sample/web/webcrypto.js", "notes": "getRandomValues / randomUUID / subtle digest, AES-GCM, HMAC" }, { "m": "Event / EventTarget / AbortController", "s": "Stable", "c": "pill-stable", "sample": "sample/web/events.js", "notes": "CustomEvent / MessageEvent / CloseEvent included" }, { "m": "performance", "s": "Stable", "c": "pill-stable", "sample": "sample/web/performance.js", "notes": "now / timeOrigin; node:perf_hooks re-exports + extras" }, { "m": "Buffer", "s": "Stable", "c": "pill-stable", "sample": "sample/web/buffer.js", "notes": "Deviation: isAscii/isUtf8/transcode absent; allocUnsafe is zero-filled" }, { "m": "WebSocket (client)", "s": "Experimental", "c": "pill-exp", "sample": "sample/web/websocket.js", "notes": "constructor shape offline; live echo via --serve, see sample/serve-hello/" }, { "m": "process / require / module", "s": "Stable", "c": "pill-stable", "sample": "sample/process/basics.js", "notes": "CJS + ESM interop; require(esm) supported" }]
  core = [{ "m": "node:assert (+/strict)", "s": "Stable", "c": "pill-stable", "sample": "sample/assert/basics.js", "notes": "ok / equal / deepEqual / throws / rejects" }, { "m": "node:async_hooks", "s": "Stable", "c": "pill-stable", "sample": "sample/observe/basics.js", "notes": "AsyncLocalStorage run/getStore across timers" }, { "m": "node:buffer", "s": "Stable", "c": "pill-stable", "sample": "sample/web/buffer.js", "notes": "same class as global Buffer" }, { "m": "node:child_process", "s": "Stable", "c": "pill-stable", "sample": "sample/child-process/spawn.js", "notes": "spawnSync/execFileSync via process.execPath (cross-platform)" }, { "m": "node:cluster", "s": "Stable", "c": "pill-stable", "sample": "sample/cluster/primary-worker.js", "notes": "thread-based; fork / message / disconnect / exit" }, { "m": "node:console", "s": "Stable", "c": "pill-stable", "sample": "sample/web/console.js", "notes": "Console class over custom streams" }, { "m": "node:crypto", "s": "Stable", "c": "pill-stable", "sample": "sample/crypto/hash.js", "notes": "hash / HMAC / AES-GCM+CCM / ChaCha20 / ECDSA / Ed25519 / ECDH; CCM needs authTagLength" }, { "m": "node:domain", "s": "Bridge", "c": "pill-bridge", "sample": "sample/observe/basics.js", "notes": "sync routing only; async not routed" }, { "m": "node:events", "s": "Stable", "c": "pill-stable", "sample": "sample/events/emitter.js", "notes": "on / once / off / error / maxListeners" }, { "m": "node:fs (+/promises)", "s": "Stable", "c": "pill-stable", "sample": "sample/fs/read-write.js", "notes": "sync / callback / promise / stream / watch faces" }, { "m": "node:module", "s": "Stable", "c": "pill-stable", "sample": "sample/module/main.mjs", "notes": "createRequire, builtin require" }, { "m": "node:os", "s": "Stable", "c": "pill-stable", "sample": "sample/os/info.js", "notes": "platform / arch / cpus / mem / user / uptime / net" }, { "m": "node:path (+/posix, +/win32)", "s": "Stable", "c": "pill-stable", "sample": "sample/path/basics.js", "notes": "join / resolve / parse / relative / extname" }, { "m": "node:process", "s": "Stable", "c": "pill-stable", "sample": "sample/process/basics.js", "notes": "argv / env / cwd / versions / hrtime / nextTick" }, { "m": "node:stream (+/promises, /consumers, /web)", "s": "Stable", "c": "pill-stable", "sample": "sample/stream/basics.js", "notes": "Readable / Writable / Transform / pipeline / finished / text / json" }, { "m": "node:string_decoder", "s": "Stable", "c": "pill-stable", "sample": "sample/codecs/basics.js", "notes": "split multibyte decode" }, { "m": "node:querystring / node:punycode", "s": "Stable", "c": "pill-stable", "sample": "sample/codecs/basics.js", "notes": "parse / stringify / escape; toASCII / toUnicode" }, { "m": "node:sys", "s": "Stable", "c": "pill-stable", "sample": "sample/util/basics.js", "notes": "deprecated alias, same instance as node:util" }, { "m": "node:test", "s": "Stable", "c": "pill-stable", "sample": "sample/test-runner/basics.js", "notes": "describe / it; runs under --run and --test" }, { "m": "node:timers (+/promises)", "s": "Stable", "c": "pill-stable", "sample": "sample/url-timers/basics.js", "notes": "callback + promise faces" }, { "m": "node:util (+/types)", "s": "Stable", "c": "pill-stable", "sample": "sample/util/basics.js", "notes": "format / inspect / promisify / isMap / isPromise" }, { "m": "node:v8", "s": "Bridge", "c": "pill-bridge", "sample": "sample/observe/basics.js", "notes": "only startupSnapshot; heap/serializer intentionally absent" }, { "m": "node:vm", "s": "Stable", "c": "pill-stable", "sample": "sample/vm/basics.js", "notes": "Script / context / compileFunction; host globals not leaked" }, { "m": "node:worker_threads", "s": "Stable", "c": "pill-stable", "sample": "sample/worker-threads/main.mjs", "notes": "postMessage / terminate" }, { "m": "node:zlib", "s": "Stable", "c": "pill-stable", "sample": "sample/zlib/basics.js", "notes": "gzip / deflate / brotli / crc32" }]
  netio = [{ "m": "node:http", "s": "Stable", "c": "pill-stable", "sample": "sample/http/server-client.js", "notes": "keep-alive agent, streaming bodies" }, { "m": "node:http2", "s": "Stable", "c": "pill-stable", "sample": "sample/http2/h2c.js", "notes": "h2c compat server + client session" }, { "m": "node:https", "s": "Stable", "c": "pill-stable", "sample": "sample/https/get.js", "notes": "Deviation: request listener currently fires twice per request — guard idempotently" }, { "m": "node:tls (+_tls_wrap)", "s": "Stable", "c": "pill-stable", "sample": "sample/tls/server-client.js", "notes": "fixture cert; _tls_wrap emits DEP0192" }, { "m": "node:net", "s": "Stable", "c": "pill-stable", "sample": "sample/net/tcp.js", "notes": "TCP echo; isIP / isIPv4 / isIPv6" }, { "m": "node:dgram", "s": "Stable", "c": "pill-stable", "sample": "sample/dgram/udp.js", "notes": "udp4 echo; multicast / connect supported" }, { "m": "node:dns (+/promises)", "s": "Stable", "c": "pill-stable", "sample": "sample/dns/lookup.js", "notes": "lookup(localhost) offline; full resolver via system DNS" }, { "m": "node:quic", "s": "Experimental", "c": "pill-exp", "sample": "—", "notes": "QuicEndpoint / listen / connect; needs UDP loopback" }, { "m": "node:diagnostics_channel", "s": "Stable", "c": "pill-stable", "sample": "sample/observe/basics.js", "notes": "channel publish / subscribe" }, { "m": "node:inspector (+/promises)", "s": "Bridge", "c": "pill-bridge", "sample": "—", "notes": "Session / open / url; no live debugging wire" }, { "m": "node:trace_events", "s": "Bridge", "c": "pill-bridge", "sample": "—", "notes": "createTracing / getEnabledCategories" }, { "m": "node:tty", "s": "Stable", "c": "pill-stable", "sample": "sample/observe/basics.js", "notes": "isatty / ReadStream / WriteStream" }, { "m": "node:readline", "s": "Stable", "c": "pill-stable", "sample": "sample/readline/basics.js", "notes": "stream-backed, no TTY needed" }, { "m": "node:repl", "s": "Stable", "c": "pill-stable", "sample": "—", "notes": "REPLServer / start / Recoverable" }, { "m": "node:sqlite / bun:sqlite", "s": "Stable", "c": "pill-stable", "sample": "sample/sqlite/basics.js", "notes": "DatabaseSync / Database, in-memory verified" }, { "m": "node:url (legacy)", "s": "Stable", "c": "pill-stable", "sample": "sample/url-timers/basics.js", "notes": "parse / format / resolve / Url class" }, { "m": "node:perf_hooks", "s": "Stable", "c": "pill-stable", "sample": "sample/observe/basics.js", "notes": "performance object" }]

template:
  h1 winterjs API Reference
  blockquote Style follows #[a(href='https://nodejs.org/docs/latest/api/') nodejs.org/api]: one section per module, stability marker, import form, sample link, and #[strong known deviations] (verified against #[code winterjs --run sample/...], 2026-09-27). 中文版见 #[a(href='#/zh/api') API 参考].
  p Stability: #[span.pill.pill-stable Stable] tracks Node semantics; #[span.pill.pill-exp Experimental] present but evolving; #[span.pill.pill-bridge Bridge] intentionally reduced surface.
  p Quick runnable index: every row has a sample under #[code sample/&lt;area&gt;/].
  h2 Web globals (no import)
  table
    thead
      tr
        th Global
        th Stability
        th Sample
        th Notes
    tbody
      each g in web
        tr
          td: code= g.m
          td: span.pill(class=g.c)= g.s
          td
            if g.sample == '—'
              | —
            else
              button.sample-link(type='button' data-sample=g.sample title='preview source')= g.sample
          td!= g.notes
  h2 node: modules — core
  table
    thead
      tr
        th Module
        th Stability
        th Sample
        th Notes
    tbody
      each m in core
        tr
          td: code= m.m
          td: span.pill(class=m.c)= m.s
          td
            if m.sample == '—'
              | —
            else
              button.sample-link(type='button' data-sample=m.sample title='preview source')= m.sample
          td!= m.notes
  h2 node: modules — network &amp; I/O
  table
    thead
      tr
        th Module
        th Stability
        th Sample
        th Notes
    tbody
      each m in netio
        tr
          td: code= m.m
          td: span.pill(class=m.c)= m.s
          td
            if m.sample == '—'
              | —
            else
              button.sample-link(type='button' data-sample=m.sample title='preview source')= m.sample
          td!= m.notes
  h2 Not supported (by design)
  ul
    li #[code wasi], #[code sea] — no equivalent planned.
    li N-API native addons (#[code .node]) load via the napi surface, but writing C addons against winterjs headers is out of scope for these samples.
  h2 Errors &amp; warnings
  ul
    li Uncaught errors render Node-style (#[code file:line], source line, #[code ^], #[code Name: message], #[code at] stack) with exit 1; #[code throw &lt;non-Error&gt;] prints the value.
    li #[code process.emitWarning] dispatches asynchronously (nextTick), matching Node.
